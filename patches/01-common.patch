+        vec4 vis = diffuse * color;
+        float cover = clamp(max(max(vis.r, vis.g), vis.b) * vis.a, 0.0, 1.0);
+        if(cover < 0.12) cover = 0.0;
+        gl_FragColor = vec4(cover, cover, cover, 1.0);
+    }
