diff --git a/src/engine/rendergl.cpp b/src/engine/rendergl.cpp
index d4a1fd9f70c14cdd5284d6ce85c877fea72df987..db0987d0778c097a37f5492abcef0ad3d23af03b 100644
--- a/src/engine/rendergl.cpp
