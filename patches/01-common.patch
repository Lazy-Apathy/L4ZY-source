+    glActiveTexture_(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevtex);
+    if(!msaacolourfb || msaacolourw != screenw || msaacolourh != screenh)
+    {
+        if(msaacolourfb) { glDeleteFramebuffers_(1, &msaacolourfb); msaacolourfb = 0; }
