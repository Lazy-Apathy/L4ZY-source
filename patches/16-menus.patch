+// Mises a jour L4ZY. Tout part d'un clic : rien ne ferme une partie tout
+// seul. Le redemarrage automatique n'a lieu qu'apres "Update and restart" et
+// seulement si le joueur attend ici, hors partie.
+newgui updates [
+    tupdatesync
+    guitext (concatword "Installed: ^f0L4ZY " (tupdateinstalled) "^f7   channel: " (tupdatechannel)) 0
+    if (! (tupdateservice)) [
+        guitext "^f3Update service not running. Start the game with L4ZY.exe." 0
+    ]
+    guitextbox (tupdatemsg) 60 1
+    guibar
+    if (= $tupdateavail 0) [
+        guistayopen [ guibutton "Check for updates" [tupdatecheck] ]
+    ]
+    if (= $tupdateavail 1) [
+        guistayopen [ guibutton (tupdatelabel) [tupdateapply] ]
+        guitext "^f4Downloads in the background. The game restarts only when you say so." 0
+        guistayopen [ guibutton "Check again" [tupdatecheck] ]
+    ]
+    if (= $tupdateavail 2) [
+        guitext (tupdatelabel) 0
+        guitext "^f4You can keep playing. Nothing is replaced until the game restarts." 0
+    ]
+    if (= $tupdateavail 3) [
+        guistayopen [ guibutton "^f0Restart now to install" [tupdaterestart] ]
+        if (isconnected) [
+            guitext "^f4You are in a game: restart when you are ready." 0
+        ] [
+            if (tupdatewantrestart) [ tupdaterestart ]
+        ]
+    ]
+] "Updates"
