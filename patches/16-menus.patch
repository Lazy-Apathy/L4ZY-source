+GFX_prof1 = "2 1 1 1 1 0 0 1 1 32 1 0 4 8 2 0 2 1 5 2"
+GFX_prof2 = "1 1 1 2 1 1024 1 1 1 32 1 0 3 4 2 0 1 1 5 2"
+GFX_prof3 = "0 1 1 2 1 1024 1 1 1 32 1 0 2 2 2 0 1 1 5 0"
+GFX_profis = [
+    GFX_pv = (getalias (concatword "GFX_prof" $arg1))
+    GFX_pr = 1
+    loop GFX_pi (listlen $GFX_profvars) [
