+// weapon trail colour row: colour really used (hex in that colour), hex field,
+// "same as All" (Me / Others) or "stock" (All), a few presets.
+// arg1 = trail colour variable, or projectile colour variable (projcolor...,
+// projmycolor..., projothercolor...) (also names it for the settings search)
+trailcolourpicks = [
+    guilist [
+        guicolor (trailcolorvalue $arg1)
+        guistrut 1
+        if (!=s (textfocus) (concatword "trailhex" $arg1)) [alias (concatword "trailhex" $arg1) (settrailcolor $arg1)]
+        guifield (concatword "trailhex" $arg1) 7 [settrailcolor @arg1 (getalias (concatword "trailhex" @arg1))]
+        guistrut 1
+        if (&& (strstr $arg1 "trailcolor") (strstr $arg1 "projcolor")) [
+            guibutton "same as All" [settrailcolor @arg1 same] 0
+        ] [
+            guibutton "stock" [settrailcolor @arg1 stock] 0
+        ]
+        guistrut 1
+        guibutton "^f7white" [settrailcolor @arg1 FFFFFF] 0
+        guistrut 1
+        guibutton "^f8cyan" [settrailcolor @arg1 60F0FF] 0
+        guistrut 1
+        guibutton "^f0green" [settrailcolor @arg1 40FF80] 0
+        guistrut 1
+        guibutton "^f2yellow" [settrailcolor @arg1 FFC040] 0
+        guistrut 1
+        guibutton "^f3red" [settrailcolor @arg1 FF4040] 0
+    ]
+]
