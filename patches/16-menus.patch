+GFX_perfcol = 14
+// Graphics > Performance: profiles Ultra / High / Medium / Low, from the best
+// picture to the fastest. One value per setting, in the order of GFX_profvars.
+// Ultra = the values the game uses today (data/hwrt.cfg gives hwrtdlights 4,
+// hwrtglowdlights 8, hwrtskyrays 1, hwrtskytemporal 32 before config.cfg).
+// A lower profile never raises what a higher one lowered. Soft shadows and their
+// rays / denoiser are set too (Graphics > Ray tracing; Low turns them off). The active profile is
+// found by comparing the current values (Custom = none): nothing is stored,
+// nothing waits. A value is only set when it differs (some settings reload
+// textures when set).
+GFX_profvars = "hwrtquality hwrtdlsscnn hwrtskyopaque hwrtnrdlight hwrtvelstatic hwrtskyrange hwrtrtadapt hwrtnrd hwrtskyrays hwrtskytemporal hwrtskyfilter hwrtsundisk hwrtdlights hwrtglowdlights hwrtdiffupscale hwrtdiffmipbias hwrtsoftshadowrays hwrtsoftsigma hwrtsoftsigmahistory hwrtsoftshadows"
