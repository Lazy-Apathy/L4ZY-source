+        velputrgb(follow, j, i, cr0, cg0, cb0);
+        int pr = prev.data[(i * w + j) * 3], pg = prev.data[(i * w + j) * 3 + 1], pb = prev.data[(i * w + j) * 3 + 2];
+        velputrgb(follow, j + w, i, pr, pg, pb);
+        if(cov >= 0.5f)
+        {
+            float pu = (j + 0.5f) / w + vx / w + (jpx - jcx) / w;
