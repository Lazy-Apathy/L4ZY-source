+    parts[PART_EXPLOSION]->labages(st.nexp, st.ageexp_min, st.ageexp_max);
+    parts[PART_SMOKE]->labages(st.nsmoke, st.agesmoke_min, st.agesmoke_max);
+    st.kind = labkind;
+    st.dist = labdist;
+    st.ox = laborigin.x;
+    st.oy = laborigin.y;
+    st.oz = laborigin.z;
+    for(listparticle *p = fireballs.list; p; p = p->next)
+    {
+        int ts = p->fade <= 5 ? 1 : lastmillis - p->millis;
+        float size = p->fade ? float(ts) / p->fade : 1;
+        float psize = p->size + p->val * size;
+        st.growth = size;
