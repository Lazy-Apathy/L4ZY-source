+    setvar("hudgunsway", 0);
+    setvar("hwrtvelholdcam", 0);
+    setvar("hwrtvelholdplayer", 0);
+    extern int thirdperson;
+    thirdperson = 0;
+    if(player)
+    {
+        player->o = o;
+        player->yaw = yaw;
+        player->pitch = pitch;
+        player->vel = vec(0, 0, 0);
+        player->falling = vec(0, 0, 0);
+        player->move = 0;
+        player->strafe = 0;
+        player->resetinterp();
+    }
+    if(camera1)
+    {
+        camera1->o = o;
+        camera1->yaw = yaw;
+        camera1->pitch = pitch;
+    }
