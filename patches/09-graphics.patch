+        // GL draws the dirt opaque then blends grass with lightmap.a.
+        uint lmid = t.y & 0xFFFFu;
+        uint bot = t.y >> 16u;
+        if(bot != 0xFFFFu && ndiff > 0 && int(bot) < ndiff)
+        {
+            float botlod = 0.0;
+            vec3 botc = colorTex(sampleWorldDiff(int(bot), btc, p, p0, p1, p2, n, btc0, btc1, btc2, t.x >> 29u, botlod));
+            float ba = 1.0;
+            int nlm = textureSize(lightmaps, 0).z;
+            if(lmid >= 6u && nlm > 0 && int(lmid) < nlm)
+                ba = texture(lightmaps, vec3(lm, float(lmid))).a;
+            albedo = mix(botc, albedo, ba);
+            difflod = max(difflod, botlod);
+        }
+        vec3 scale = vec3(float(t.z & 255u), float((t.z >> 8u) & 255u), float((t.z >> 16u) & 255u)) * (1.0 / 255.0);
+        albedo *= scale;
+#ifndef HWRT_NO_REFL
+        envbits = t.z >> 24u;
+        // The spec shaders' highlight and the envmap mirror both follow the
+        // normal map, as in GL; the diffuse lighting keeps the flat face.
+        uint specq = (t.x >> 9u) & 255u;
+        bool wantspec = (pc.mode & SPEC) != 0 && specq != 0u;
+        bool wantenv = (pc.mode & REFL_WORLD) != 0 && envbits != 0u;
+        if(wantspec || wantenv)
+        {
+            uvgrad = worldUvGrad(p, p0, p1, p2, n, tc0, tc1, tc2, tc);
+            vec4 ns = worldNormalSpec((t.x >> 18u) & 255u, tc, uvgrad, p0, p1, p2, n, tc0, tc1, tc2);
+            bumpn = ns.xyz;
+            if(ns.w >= 0.0) specmask = ns.w;
+            else if(ndiff > 0 && layer < ndiff)
+                specmask = textureGrad(diffuses, vec3(tc, float(layer)), uvgrad.xy, uvgrad.zw).a;
+        }
+        if(wantspec)
+        {
+            wspecScale = float(specq) * (1.0 / 16.0);
+            if((t.x & 0x20000u) != 0u) wspecScale *= specmask;
+            gWSpecOn = wspecScale > 0.0;
+            gWSpecN = bumpn;
+        }
+#endif
+        // t.w: low 8 = glow layer (0xFF = none), high 24 = glowcolor rgb.
+        uint glayer = t.w & 255u;
+        int nglow = int(lights.env.glowLayers + 0.5);
+        if(glayer != 255u && nglow > 0 && int(glayer) < nglow)
+        {
+            vec3 gcol = vec3(float((t.w >> 8u) & 255u), float((t.w >> 16u) & 255u), float((t.w >> 24u) & 255u)) * (1.0 / 255.0);
+            emit = colorTex(texture(glows, vec3(tc, float(glayer))).rgb) * colorTex(gcol);
+        }
+        // Smooth normals: the per-vertex normals of the classic lightmap bake
+        // (as.cpp, smoothworldnormals). A vertex with no stored normal carries
+        // +Z (octarender) and takes the flat face normal. Only the diffuse
+        // light and the sky change; UVs, specular, reflections and the shadow
+        // ray offset (noffset) keep the flat face.
+        if(smoothNormalsOn())
+        {
+            vec3 vn0 = verts.v[i0].n, vn1 = verts.v[i1].n, vn2 = verts.v[i2].n;
+            bool flatz = abs(n.z) > 0.999;
+            if(!flatz && abs(vn0.x) + abs(vn0.y) < 0.02 && vn0.z > 0.99) vn0 = n;
+            if(!flatz && abs(vn1.x) + abs(vn1.y) < 0.02 && vn1.z > 0.99) vn1 = n;
+            if(!flatz && abs(vn2.x) + abs(vn2.y) < 0.02 && vn2.z > 0.99) vn2 = n;
+            if(dot(vn0, n) < 0.0) vn0 = -vn0;
+            if(dot(vn1, n) < 0.0) vn1 = -vn1;
+            if(dot(vn2, n) < 0.0) vn2 = -vn2;
+            vec3 sn = vn0 * a + vn1 * b + vn2 * c;
+            float sl = length(sn);
+            if(sl > 1e-4)
+            {
+                sn /= sl;
+                if(dot(sn, n) > 0.3) { gFlatN = n; gSmoothed = true; n = sn; }
+            }
+        }
+    }
+    else
+    {
+        // A model hit. Do not feed prim into the world SSBOs. No shade flag
+        // (overflow, static OBJ, pose not yet known) stores transparent so
+        // GL's raster shows through.
+        if((pc.mode & SHADE_MODELS) == 0 || (custom & 0xFFu) >= MAXGEOMS)
+            break;
+        // customIndex is per-instance, so neighbouring pixels in a subgroup
+        // hit different BLASes. Without nonuniformEXT the whole subgroup can
+        // load one slot and then fail prim>=ntris / flags on the others.
+        ModelGeom g = geoms.g[nonuniformEXT(custom & 0xFFu)];
