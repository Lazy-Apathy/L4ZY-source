+    glBindFramebuffer_(GL_FRAMEBUFFER, velfb);
+    glViewport(0, 0, velw, velh);
+    glDisable(GL_POLYGON_OFFSET_FILL);
+    glPolygonOffset(0, 0);
+    glDepthFunc(GL_LESS);
+    glDisable(GL_STENCIL_TEST);
