+    vec3 noffset = n;
+    vec2 tc = vec2(0.0);
+    envbits = 0u;
+    bumpn = n;
+    specmask = 1.0;
+    vec4 uvgrad = vec4(0.0);
+    wspecScale = 0.0;
+    uint modelmask = 0xFFu;
+    float modelspec = 0.5;
