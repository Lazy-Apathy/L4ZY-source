+static void velbindskelprevdraw(velskelhist &h)
+{
+    velskelprevb = NULL;
+    velskelprevn = 0;
+    if(h.prevdraw && h.nprevdraw > 0 && h.validprev && !velcutframe)
+    {
+        velskelprevb = h.prevdraw;
+        velskelprevn = h.nprevdraw;
+    }
+}
