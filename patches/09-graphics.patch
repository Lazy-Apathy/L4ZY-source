+                bestDir = dir2;
+                recovered = true;
+            }
+            if(recovered)
+            {
+                custom = bestCustom;
+                prim = bestPrim;
+                hitInst = bestInst;
+                bary = bestBary;
+                a = 1.0 - bary.x - bary.y;
+                b = bary.x;
+                c = bary.y;
+                hitT = bestT;
+                dir = bestDir;
+                hit = origin + dir * hitT;
