+    copystring(clean, name);
+    for(char *s = clean; *s; s++) if(*s == '/' || *s == '\\' || *s == ':' || iscubespace(*s)) *s = '_';
+
+    string savedhome;
+    copystring(savedhome, homedir);
+    homedir[0] = '\0';
+    velshotdir();
+
+    int w = velw, h = velh;
+    if(w > screenw) w = screenw;
+    if(h > screenh) h = screenh;
