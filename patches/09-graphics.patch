+// HWRT animated BLAS: CPU-skin the bind pose with this frame's bones (the
+// same interpverts / blendcombo path the rasteriser uses). gpuskel stays on;
+// interpbones() already ran on the CPU for the GL pass. Keyed like skelcache
+// (animstate, pitch, partmask, ragdoll), not by dynent.
+
+static uint hwrtmix(uint h, uint v)
+{
+    return (h ^ v) * 16777619u;
+}
+
+static uint hwrtmixf(uint h, float f)
+{
+    union { float f; uint u; } u;
+    u.f = f;
+    return hwrtmix(h, u.u);
+}
+
+static bool hwrtfillas(animmodel::part *p, dynent *d, animmodel::animstate *as)
+{
+    if(!p || !d) return false;
+    int n = min(p->numanimparts, int(MAXANIMPARTS));
+    bool any = false;
+    loopi(MAXANIMPARTS)
+    {
+        as[i].owner = p;
+        as[i].interp = 1;
+        as[i].cur.anim = as[i].prev.anim = 0;
+        as[i].cur.fr1 = as[i].cur.fr2 = as[i].prev.fr1 = as[i].prev.fr2 = 0;
+        as[i].cur.t = as[i].prev.t = 0;
+    }
+    loopi(n)
+    {
+        int interp = p->index+i;
+        if(interp<0 || interp>=MAXANIMPARTS) continue;
+        animinterpinfo &ai = d->animinterp[interp];
+        if(ai.cur.range < 1) continue;
+        // Frames recorded for another skeleton (the player model changed and
+        // this dynent was not drawn by the rasteriser since, e.g. your own
+        // body in first person) would index past this skeleton's frames.
+        // Leave this part in its bind pose until the next raster draw.
+        if(ai.lastmodel != (p->meshes ? p->meshes->animkey() : NULL)) continue;
+        as[i].cur.setframes(ai.cur);
+        if(ai.prev.range>0)
+        {
+            int aitime = animationinterpolationtime;
+            if(aitime < 1) aitime = 1;
+            int diff = lastmillis-ai.lastswitch;
+            if(diff<aitime)
+            {
+                as[i].prev.setframes(ai.prev);
+                as[i].interp = diff/float(aitime);
+            }
+        }
+        any = true;
+    }
+    return any;
+}
+
+static uint hwrtashash(const animmodel::animstate *as, int n, float pitch, const void *partmask, void *ragdoll, int lastmove)
+{
+    uint h = 2166136261u;
+    h = hwrtmixf(h, pitch);
+    h = hwrtmix(h, uint(size_t(partmask)));
+    h = hwrtmix(h, uint(size_t(ragdoll)));
+    h = hwrtmix(h, uint(lastmove));
+    loopi(n)
+    {
+        h = hwrtmix(h, uint(as[i].cur.fr1));
+        h = hwrtmix(h, uint(as[i].cur.fr2));
+        h = hwrtmixf(h, as[i].cur.t);
+        h = hwrtmixf(h, as[i].interp);
+        if(as[i].interp<1)
+        {
+            h = hwrtmix(h, uint(as[i].prev.fr1));
+            h = hwrtmix(h, uint(as[i].prev.fr2));
+            h = hwrtmixf(h, as[i].prev.t);
+        }
+    }
+    return h ? h : 1;
+}
+
+// The lighting shader wants a normal as well as a position, so the bone
+// transform is applied to vert.norm the way interpverts() does. The instance
+// matrix is a rigid rotation, so the model-space normal only needs the part
+// transform here.
+static float hwrtcurglow(const animmodel::skin &s)
+{
+    float g = s.glow;
+    if(s.glowpulse > 0)
+    {
+        float curpulse = lastmillis * s.glowpulse;
+        curpulse -= floor(curpulse);
+        g += s.glowdelta * 2 * fabs(curpulse - 0.5f);
+    }
+    return g;
+}
+
+static vec2 hwrtenvscale(const animmodel::skin *s)
+{
+    if(!s || !envmapmodels || s->envmapmax <= 0) return vec2(0, 0);
+    if(s->envmap && s->envmap->id) hwrtnoteenvmap(s->envmap->id);
+    return vec2(s->envmapmin, s->envmapmax);
+}
+
+static void hwrtenvverts(hwrtskingeom &geom, int nverts, const animmodel::skin *s)
+{
+    vec2 em = hwrtenvscale(s);
+    loopi(nverts) geom.envscales.add(em);
+}
+
+static void hwrtpushskin(hwrtskingeom &geom, Texture *tex, const animmodel::skin *s)
+{
+    geom.skins.add(tex ? uint(tex->id) : 0);
+    uint mid = 0;
+    float glow = 3.0f;
+    float spec = 1.0f;
+    if(s)
+    {
+        if(s->masked() && s->masks && s->masks != notexture) mid = uint(s->masks->id);
+        glow = hwrtcurglow(*s);
+        spec = s->spec;
+    }
+    geom.masks.add(mid);
+    geom.glows.add(glow);
+    geom.specs.add(spec);
+}
+
+static void hwrtskinskelmesh(skelmodel::skelmesh &mesh, skelmodel::skelmeshgroup *mg, const dualquat *bdata, const matrix4x3 &xf, hwrtskingeom &geom, Texture *tex, const animmodel::skin *s)
+{
+    if(!mesh.verts || !mesh.tris || mesh.numtris < 1 || mesh.numverts < 1) return;
+    uint base = uint(geom.positions.length());
+    loopi(mesh.numverts)
+    {
+        const skelmodel::vert &src = mesh.verts[i];
+        vec pos = src.pos, norm = src.norm;
+        if(bdata && mg && mg->skel && mg->blendcombos.inrange(src.blend))
+        {
+            const skelmodel::blendcombo &c = mg->blendcombos[src.blend];
+            int nbones = mg->skel->numinterpbones;
+            if(c.interpbones[0] >= 0 && c.interpbones[0] < nbones)
+            {
+                dualquat b;
+                if(c.weights[1] && c.interpbones[1] < nbones)
+                {
+                    skelmodel::skelmeshgroup::blendbones(b, bdata, c);
+                    b.normalize();
+                }
+                else b = bdata[c.interpbones[0]];
+                pos = b.transform(src.pos);
+                norm = b.transformnormal(src.norm);
+            }
+        }
+        geom.positions.add(xf.transform(pos));
+        vec n = xf.transformnormal(norm);
+        if(n.magnitude() > 1e-6f) n.normalize();
+        else n = vec(0, 0, 0);
+        geom.norms.add(n);
+        geom.tcs.add(src.tc);
+    }
+    hwrtenvverts(geom, mesh.numverts, s);
+    loopi(mesh.numtris)
+    {
+        const skelmodel::tri &t = mesh.tris[i];
+        geom.indices.add(base + t.vert[0]);
+        geom.indices.add(base + t.vert[1]);
+        geom.indices.add(base + t.vert[2]);
+        hwrtpushskin(geom, tex, s);
+    }
+}
+
+static uint hwrtmixstr(uint h, const char *s)
+{
+    if(!s) return h;
+    for(; *s; s++) h = hwrtmix(h, uint((uchar)*s));
+    return h;
+}
+
+static void hwrtskinvertat(vertmodel *vm, const matrix4x3 &parent, hwrtskingeom &geom)
+{
+    if(!vm || vm->parts.empty() || !vm->parts[0]->meshes) return;
+    animmodel::part *p = vm->parts[0];
+    vertmodel::vertmeshgroup *mg = (vertmodel::vertmeshgroup *)p->meshes;
+    if(!mg || mg->numframes < 1) return;
+    matrix4x3 xf = parent;
+    xf.scale(vm->scale);
+    xf.translate(p->translate);
+    loopv(mg->meshes)
+    {
+        vertmodel::vertmesh *mesh = (vertmodel::vertmesh *)mg->meshes[i];
+        if(!mesh || !mesh->verts || !mesh->tcverts || !mesh->tris || mesh->numtris < 1) continue;
+        Texture *tex = p->skins.inrange(i) ? p->skins[i].tex : NULL;
+        if(tex && (tex->type&Texture::ALPHA)) continue;
+        int nverts = mesh->numverts;
+        const vertmodel::vert *src = mesh->verts;
+        uint base = uint(geom.positions.length());
+        loopj(nverts)
+        {
+            geom.positions.add(xf.transform(src[j].pos));
+            vec n = xf.transformnormal(src[j].norm);
+            if(n.magnitude() > 1e-6f) n.normalize();
+            else n = vec(0, 0, 0);
+            geom.norms.add(n);
+            geom.tcs.add(mesh->tcverts[j].tc);
+        }
+        hwrtenvverts(geom, nverts, p->skins.inrange(i) ? &p->skins[i] : NULL);
+        loopj(mesh->numtris)
+        {
+            const vertmodel::tri &t = mesh->tris[j];
+            geom.indices.add(base + t.vert[0]);
+            geom.indices.add(base + t.vert[1]);
+            geom.indices.add(base + t.vert[2]);
+            hwrtpushskin(geom, tex, p->skins.inrange(i) ? &p->skins[i] : NULL);
+        }
+    }
+}
+
+// Gun / armour sit on a tag. Bind-pose verts at that tag: they do not play
+// the player's run cycle (GL uses ANIM_VWEP_IDLE / ANIM_SHIELD on the child).
+static void hwrtskinpartat(animmodel::part *p, const matrix4x3 &parent, hwrtskingeom &geom)
+{
+    if(!p || !p->model || !p->meshes) return;
+    if(p->model->skeletal())
+    {
+        skelmodel::skelmeshgroup *mg = (skelmodel::skelmeshgroup *)p->meshes;
+        matrix4x3 xf = parent;
+        xf.scale(p->model->scale);
+        xf.translate(p->translate);
+        loopv(mg->meshes)
+        {
+            skelmodel::skelmesh *mesh = (skelmodel::skelmesh *)mg->meshes[i];
+            if(!mesh) continue;
+            Texture *tex = p->skins.inrange(i) ? p->skins[i].tex : NULL;
+            if(tex && (tex->type&Texture::ALPHA)) continue;
+            hwrtskinskelmesh(*mesh, NULL, NULL, xf, geom, tex, p->skins.inrange(i) ? &p->skins[i] : NULL);
+        }
+        return;
+    }
+    if(p->model->type()==MDL_MD2 || p->model->type()==MDL_MD3)
+        hwrtskinvertat((vertmodel *)p->model, parent, geom);
+}
+
+static bool hwrtskinskelpart(skelmodel::skelpart *p, dynent *d, float pitch, const matrix4x3 &parent, bool wantgeom, hwrtskingeom *geom)
+{
+    if(!p || !p->meshes) return false;
+    skelmodel::skelmeshgroup *mg = (skelmodel::skelmeshgroup *)p->meshes;
+    if(!mg->skel || mg->skel->numframes < 1) return false;
+
+    animmodel::animstate as[MAXANIMPARTS];
+    ragdolldata *rdata = NULL;
+    if(d && d->ragdoll && d->ragdoll->skel == mg->skel->ragdoll) rdata = d->ragdoll;
+    hwrtfillas(p, d, as);
+    if(!rdata && (!d || !d->animinterp[0].lastmodel)) return false;
+
+    vec axis(0, -1, 0), forward(1, 0, 0);
+    skelmodel::skelcacheentry &sc = mg->skel->checkskelcache(p, as, pitch, axis, forward, rdata);
+    if(!sc.bdata) return false;
+
+    if(wantgeom && geom)
+    {
+        matrix4x3 xf = parent;
+        xf.scale(p->model->scale);
+        xf.translate(p->translate);
+        loopv(mg->meshes)
+        {
+            skelmodel::skelmesh *mesh = (skelmodel::skelmesh *)mg->meshes[i];
+            if(!mesh) continue;
+            Texture *tex = p->skins.inrange(i) ? p->skins[i].tex : NULL;
+            if(tex && (tex->type&Texture::ALPHA)) continue;
+            hwrtskinskelmesh(*mesh, mg, sc.bdata, xf, *geom, tex, p->skins.inrange(i) ? &p->skins[i] : NULL);
+        }
+        mg->skel->calctags(p, &sc);
+        loopv(p->links)
+        {
+            animmodel::linkedpart &l = p->links[i];
+            if(!l.p || !l.p->model) continue;
+            matrix4x3 child(l.matrix);
+            child.translate(l.translate, p->model->scale);
+            // Same skeleton, another part: keep the player's pose.
+            // A different model on a tag is a gun/armour: bind pose at the tag.
+            if(l.p->model == p->model && l.p->model->skeletal())
+                hwrtskinskelpart((skelmodel::skelpart *)l.p, d, pitch, child, true, geom);
+            else hwrtskinpartat(l.p, child, *geom);
+        }
+    }
+    return true;
+}
+
+static bool hwrtskinvertmodel(vertmodel *vm, dynent *d, float pitch, bool wantgeom, hwrtskingeom *geom, hwrtposekey &key)
+{
+    if(!vm || vm->parts.empty() || !vm->parts[0]->meshes) return false;
+    vertmodel::vertmeshgroup *mg = (vertmodel::vertmeshgroup *)vm->parts[0]->meshes;
+    if(mg->numframes <= 1) return false;
+    animmodel::part *p = vm->parts[0];
+    animmodel::animstate as[MAXANIMPARTS];
+    if(!hwrtfillas(p, d, as)) return false;
+
+    key.m = vm;
+    key.ragdoll = d ? d->ragdoll : NULL;
+    key.worldspace = false;
+    key.hash = hwrtashash(as, min(p->numanimparts, int(MAXANIMPARTS)), pitch, NULL, key.ragdoll, 0);
+    if(!wantgeom || !geom) return true;
+
+    matrix4x3 xf;
+    vm->initmatrix(xf);
+    xf.scale(vm->scale);
+    xf.translate(p->translate);
+
+    const animmodel::animstate &st = as[0];
+    loopv(mg->meshes)
+    {
+        vertmodel::vertmesh *mesh = (vertmodel::vertmesh *)mg->meshes[i];
+        if(!mesh || !mesh->verts || !mesh->tcverts || !mesh->tris || mesh->numtris < 1) continue;
+        Texture *tex = p->skins.inrange(i) ? p->skins[i].tex : NULL;
+        if(tex && (tex->type&Texture::ALPHA)) continue;
+        int nverts = mesh->numverts;
+        int nframes = mg->numframes;
+        if(st.cur.fr1<0 || st.cur.fr2<0 || st.cur.fr1>=nframes || st.cur.fr2>=nframes) continue;
+        const vertmodel::vert *vert1 = &mesh->verts[st.cur.fr1 * nverts];
+        const vertmodel::vert *vert2 = &mesh->verts[st.cur.fr2 * nverts];
+        const vertmodel::vert *pvert1 = st.interp<1 && st.prev.fr1>=0 && st.prev.fr1<nframes ? &mesh->verts[st.prev.fr1 * nverts] : NULL;
+        const vertmodel::vert *pvert2 = st.interp<1 && st.prev.fr2>=0 && st.prev.fr2<nframes ? &mesh->verts[st.prev.fr2 * nverts] : NULL;
+        uint base = uint(geom->positions.length());
+        loopj(nverts)
+        {
+            vec pos, norm;
+            pos.lerp(vert1[j].pos, vert2[j].pos, st.cur.t);
+            norm.lerp(vert1[j].norm, vert2[j].norm, st.cur.t);
+            if(pvert1 && pvert2)
+            {
+                vec ppos, pnorm;
+                ppos.lerp(pvert1[j].pos, pvert2[j].pos, st.prev.t);
+                pos.lerp(ppos, pos, st.interp);
+                pnorm.lerp(pvert1[j].norm, pvert2[j].norm, st.prev.t);
+                norm.lerp(pnorm, norm, st.interp);
+            }
+            geom->positions.add(xf.transform(pos));
+            vec n = xf.transformnormal(norm);
+            if(n.magnitude() > 1e-6f) n.normalize();
+            else n = vec(0, 0, 0);
+            geom->norms.add(n);
+            geom->tcs.add(mesh->tcverts[j].tc);
+        }
+        hwrtenvverts(*geom, nverts, p->skins.inrange(i) ? &p->skins[i] : NULL);
+        loopj(mesh->numtris)
+        {
+            const vertmodel::tri &t = mesh->tris[j];
+            geom->indices.add(base + t.vert[0]);
+            geom->indices.add(base + t.vert[1]);
+            geom->indices.add(base + t.vert[2]);
+            hwrtpushskin(*geom, tex, p->skins.inrange(i) ? &p->skins[i] : NULL);
+        }
+    }
+    return geom->indices.length() >= 3;
+}
+
+void hwrtlookupskin(model *m, Texture *tex, Texture *&masks, float &glow, float &spec, float &envmin, float &envmax, GLuint &envid, float &alphatest)
+{
+    masks = NULL;
+    glow = 3.0f;
+    spec = 1.0f;
+    envmin = 0;
+    envmax = 0;
+    envid = 0;
