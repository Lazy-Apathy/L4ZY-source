+        if(glen > 1e-8) n = gn / glen;
+        else
+        {
+            float nlen = length(n);
+            if(nlen < 1e-6) n = -dir;
+            else n /= nlen;
+        }
+        if(dot(n, -dir) < 0.0) n = -n;
+        noffset = n;
