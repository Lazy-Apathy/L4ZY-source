+bool hwrtskinmodel(dynent *d, model *m, float pitch, hwrtskingeom *geom, hwrtposekey &key)
+{
+    memset(&key, 0, sizeof(key));
+    if(!d || !m) return false;
+    if(geom) geom->reset();
+    bool wantgeom = geom != NULL;
+
+    if(m->skeletal())
+    {
+        skelmodel *sm = (skelmodel *)m;
+        if(sm->parts.empty()) return false;
+        skelmodel::skelpart *p = (skelmodel::skelpart *)sm->parts[0];
+        if(!p->meshes) return false;
+        skelmodel::skelmeshgroup *mg = (skelmodel::skelmeshgroup *)p->meshes;
+        if(!mg->skel || mg->skel->numframes < 1) return false;
+
+        animmodel::animstate as[MAXANIMPARTS];
+        ragdolldata *rdata = (d->ragdoll && d->ragdoll->skel == mg->skel->ragdoll) ? d->ragdoll : NULL;
+        if(!rdata && !d->animinterp[0].lastmodel) return false;
+        if(rdata) hwrtfillas(p, d, as);
+        else if(!hwrtfillas(p, d, as)) return false;
+
+        key.m = m;
+        key.ragdoll = rdata;
+        key.worldspace = rdata != NULL;
+        key.hash = hwrtashash(as, min(p->numanimparts, int(MAXANIMPARTS)), key.worldspace ? 0.0f : pitch, p->partmask, rdata, rdata ? rdata->lastmove : 0);
+
+        modelattach att[8];
+        memset(att, 0, sizeof(att));
+        int natt = hwrtdynentattach(d, att, 7);
+        loopi(natt)
+        {
+            key.hash = hwrtmixstr(key.hash, att[i].tag);
+            key.hash = hwrtmixstr(key.hash, att[i].name);
+            key.hash = hwrtmix(key.hash, uint(att[i].anim));
+        }
+        if(!key.hash) key.hash = 1;
+
+        if(!wantgeom) return true;
+
+        loopi(natt) if(att[i].name && !att[i].m) att[i].m = loadmodel(att[i].name);
+
+        animmodel *am = sm;
+        int numtags = 0;
+        if(natt)
+        {
+            int index = am->parts.last()->index + am->parts.last()->numanimparts;
+            for(int i = 0; att[i].tag; i++)
+            {
+                numtags++;
+                if(!att[i].m) continue;
+                if(!att[i].m->skeletal() && att[i].m->type()!=MDL_MD2 && att[i].m->type()!=MDL_MD3) continue;
+                animmodel *em = (animmodel *)att[i].m;
+                if(em->parts.empty()) continue;
+                animmodel::part *ep = em->parts[0];
+                ep->index = am->link(ep, att[i].tag, vec(0, 0, 0), att[i].anim, att[i].basetime, NULL) ? index : -1;
+                index += ep->numanimparts;
+            }
+        }
+
+        matrix4x3 parent;
+        if(key.worldspace) parent.identity();
+        else sm->initmatrix(parent);
+        bool ok = hwrtskinskelpart(p, d, key.worldspace ? 0.0f : pitch, parent, true, geom) && geom->indices.length() >= 3;
+
+        if(natt)
+        {
+            for(int i = numtags-1; i >= 0; i--)
+            {
+                if(!att[i].m) continue;
+                if(!att[i].m->skeletal() && att[i].m->type()!=MDL_MD2 && att[i].m->type()!=MDL_MD3) continue;
+                animmodel *em = (animmodel *)att[i].m;
+                if(em->parts.empty()) continue;
+                animmodel::part *ep = em->parts[0];
+                if(ep->index >= 0) am->unlink(ep);
+                ep->index = 0;
+            }
+        }
+        return ok;
+    }
+
+    if(m->type()==MDL_MD2 || m->type()==MDL_MD3)
+        return hwrtskinvertmodel((vertmodel *)m, d, pitch, wantgeom, geom, key);
+    return false;
+}
