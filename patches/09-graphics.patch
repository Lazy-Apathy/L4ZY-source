+static int enginefromgwmode(uint32_t m)
+{
+    if(m == SAUER_NGX_MODE_QUALITY) return 2;
+    if(m == SAUER_NGX_MODE_BALANCED) return 3;
+    if(m == SAUER_NGX_MODE_PERFORMANCE) return 4;
+    return 1;
+}
