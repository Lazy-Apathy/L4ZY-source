+                fsrinfo.fp16, fsrinfo.wave_min, int(hwrtfsrsharpness), hwrtfsrvram() / 1048576.0, fsrdetail);
+    else conoutf("  detail: %s", fsrdetail);
+}
+COMMAND(hwrtfsrstats, "");
+
