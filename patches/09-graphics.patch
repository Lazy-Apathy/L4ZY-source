+        destroystorage2d(skyage[i]);
+    }
+    skyhistw = skyhisth = 0;
+}
+
+bool hwrtskyhistready()
+{
+    return !skyhistfailed && skyhist[0].view && skyhist[1].view &&
+           skyage[0].view && skyage[1].view &&
+           skyhistw == hwrtio.w && skyhisth == hwrtio.h;
+}
+
+void hwrtskyhistsize(int &w, int &h)
+{
+    w = skyhistw;
+    h = skyhisth;
