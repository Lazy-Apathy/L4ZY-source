diff --git a/src/engine/hwrt/shaders/hitlight.comp b/src/engine/hwrt/shaders/hitlight.comp
new file mode 100644
index 0000000000000000000000000000000000000000..05e4adb6a1380cb887fddab3e4bf1f2b171734bb
--- /dev/null
+++ b/src/engine/hwrt/shaders/hitlight.comp
@@ -0,0 +1,3223 @@
+#version 460
+#extension GL_EXT_ray_query : require
+#extension GL_EXT_buffer_reference2 : require
+#extension GL_EXT_buffer_reference_uvec2 : require
+#extension GL_EXT_nonuniform_qualifier : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_ballot : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_vote : require
+
+// Performance pass 2: the lighting pass with the same result for every
+// pixel and less invariant work. What changed, and why it cannot change a pixel:
+//  - the light loops only visit the lamps that can pass their own range test
+//    somewhere in this 16x16 tile. Every hit of the tile is inside the tile's
+//    box, a lamp whose sphere misses that box (with a margin far above float
+//    rounding) fails `mag < radius` / `x >= 1` for every pixel of the tile, and
+//    the survivors are visited in the same increasing index order, so the same
+//    lamps are elected, with the same ties, the same caps and the same sums.
+//  - the extra rest-pose BLAS slots of the stage 2 cache (customIndex 97..160).
+
+// Point lights + sun + skylight (hwrtdebug 7 / hwrtlight 1).
+//
+// Same camera primary ray as hitshade.comp. Closest-hit interpolates diffuse
+// UV + vertex normal, samples the existing diffuse copy, evaluates every
+// uploaded radius-0 ET_LIGHT (baker unlimited omni, packed first; cap 16)
+// plus the N nearest finite-radius lights with Lambert * linear attenuation,
+// traces one shadow ray toward each chosen light, then:
+//   sunlight: Lambert * (sunlightcolor/255 * sunlightscale), one shadow ray
+//             along sunlightdir (toward the sun, same as the baker). Miss is
+//             lit; hit is not. Skipped entirely when sunlight is 0.
+//             World hits include SELF when hwrtshadowself >= 1, so the
+//             player stains the floor along the sun direction.
+//   skylight: hwrtskyrays cosine-weighted hemisphere rays around the world
+//             normal. Misses count toward a visibility fraction (the cosine
+//             pdf already matches a Lambertian sky, so there is no extra
+//             weight). Hit adds nothing. Skipped when skylight is 0.
+//             On the world that fraction lerps from ambient up to
+//             skylightcolor, like calcskylight, and the result is max()ed
+//             against sun + lamps rather than added: an open sky replaces the
+//             ambient floor, it does not stack on the sun. Models keep the
+//             plain sum, since nothing bakes them.
+//             Before that combine, hwrtskyfilter (default on) averages skyvis
+//             across the 16x16 workgroup: one 5x5 on the same plane, world vs
+//             model kept apart. Two 7x7 passes (and a flat 16x16) smeared
+//             mid/far lighting once four rays already carried the grain.
+//             Neighbours must share the same plane (so a wall/floor crease
+//             holds). Hit-distance along the ray is not the gate: a floor
+//             seen at a graze changes T across a kernel and left leftover
+//             dots in every shadow. A 2-pixel skyvis apron was measured
+//             slower than four unfiltered rays, so the filter stays inside
+//             the tile. The output alpha (model mask) is not filtered.
+//             hwrtskytemporal then keeps that fraction across frames. A new
+//             pixel (surface just back in view) starts at age 1 and mixes
+//             1/age until it reaches N; only then may hold freeze. skyvis
+//             is geometry, not shading, so a hit that reprojects onto its own
+//             stored world position inherits the whole running average, with
+//             a pixel-stable hemisphere seed (hwrtskystable) as the still-
+//             camera alternative to pixel+frame RNG.
+//             no colour clamp to cap the convergence. Four rays are 4 coin
+//             flips and the 5x5 about 12 usable taps; only the frame axis has
+//             the headroom left to put the residual under one 8-bit level
+//             after hwrtworldgain has doubled it.
+//             hwrtskybluenoise (default on) draws those rays from a 128x128
+//             blue-noise tile instead of the pcg hash for the world pixels NRD
+//             denoises: neighbours then fall on both sides of an occluder's edge
+//             in the right proportion, so the 5x5 hands REBLUR less grain. Same
+//             ray count, same estimator, same converged picture. The skyage path
+//             (Sauer filter, and models) keeps the hash: its hold re-reads a
+//             frozen history that drifts, the tile borders of the 5x5 stood out
+//             more against a cleaner interior, and a frozen residual repeated
+//             with the 128-pixel tile.
+//             World hits skip SELF unless hwrtshadowself is 2: a body that
+//             close otherwise eats the whole hemisphere and looks like a 3D
+//             pit. Other players (MODEL) still occlude sky. Lamps still see
+//             SELF at the default, so the shadow follows the lights.
+// Ambient is the existing constant. It is not counted again as sky.
+// On the world, everything above that constant is scaled by hwrtworldgain
+// (GL's colorparams overbright, default 2). Ambient itself is not, so a pixel
+// no light reaches keeps the brightness it had before the gain existed.
+// The world also clips sun + lamps to 1 before that scale, because the lumel
+// GL samples is 8 bit and cannot hold more.
+// Miss is transparent so vanilla GL shows. With SHADE_MODELS, a model hit
+// uses the same lights as the world (skin albedo × 2 like Sauer's model
+// shader, instance-transformed normal, one shadow ray each). Models use
+// the same hwrtshadowself policy as the walls (foliage included). A player
+// shadow ray skips its own TLAS instance so arms and legs do not eat every
+// sample; the visibility floor and studio fill keep the look bright.
+// Shadow rays on a model start from the triangle geometric normal with a
+// larger bias so they do not begin inside the mesh. A
+// GEOM_FULLBRIGHT instance (ENT_PLAYER, including bots in that armour) is
+// shaded like the menu preview, not like GL's in-game fullbright plate:
+// Lambert wrap + Blinn-Phong spec (masks.r, maskscale.x) + mdlenvmap
+// cubemap (masks.b, the preview's metal) + a camera+up studio fill that
+// only fills where world lights are weak + a modest visibility floor.
+// Matching GL's fullbrightmodels/100 (1.5 at Overbright) is the plastic
+// look; we do not. Crates / monsters are not marked and stay Lambert.
+// customIndex 0 is still the world SSBOs; anything else indexes the geometry
+// table, never the world buffers. Without SHADE_MODELS a model hit stores
+// vec4(0) (MASK_MODELS then hides those pixels so GL's raster survives).
+// MESH_ALPHA (leaves, CTF flags) is a second non-opaque BLAS geometry: without
+// gl_RayFlagsOpaqueEXT those triangles arrive as candidates, skins.a is
+// tested against mdlalphatest (pad1, default 0.9), and a hole lets the ray
+// continue. Opaque geometry still commits in hardware. Shadow / sun / sky
+// use the same test so a canopy casts a foliage shadow, not a solid disc.
+// Does not sample the bake for lighting. Lightmap alpha is still read for
+// texlayer floors (grass/dirt mix). Row 0 of the image is the BOTTOM of the
+// screen.
+//
+// TEST_GLDEPTH compares every world hit against the window depth GL has just
+// finished rasterising, so a hit the ray only reached by passing through
+// something still absent from the TLAS (grass, water, world alpha cubes)
+// is handed back to GL. Foliage and flags are in the TLAS now.
+//
+// Glow (Sauer's self-lit textures) is not an ET_LIGHT. World faces with a
+// glowmap add texture*glowcolor on top of the lit albedo, the way
+// glowshader does (`diffuse*lm + vec4(glow, 0)`). Model skins mix toward
+// albedo * curglow on masks.g, the way modelshader does. Playermodels also
+// add Blinn-Phong spec from masks.r. Jumppads and screens are packed as
+// always-evaluated finite omnis (flags 2, no shadow ray) so they colour
+// anyone who walks up. The default teleporter ring is flags 3: same
+// always-eval slot, but a lamp in the hole with shadow rays.
+
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(binding = 0, rgba16f) uniform writeonly image2D result;
+layout(binding = 1) uniform accelerationStructureEXT tlas;
+struct ShadeVert { vec2 tc; vec2 lm; vec3 n; float pad; vec3 pos; float pad2; };
+layout(std430, binding = 2) readonly buffer ShadeVerts { ShadeVert v[]; } verts;
+layout(std430, binding = 3) readonly buffer ShadeIdx { uint i[]; } idx;
+layout(std430, binding = 4) readonly buffer ShadeTri { uvec4 t[]; } tri;
+layout(binding = 5) uniform sampler2DArray diffuses;
+struct LightEnv {
+    vec3 sunDir;
+    float sunOn;
+    vec3 sunColor;
+    float skyRays;    // 1..4, +0.25 when hwrtskyfilter
+    vec3 skyColor;
+    float skyOn;
+    float modelMin;   // visibility floor for GEOM_FULLBRIGHT, not GL's 1.5 plate
+    float worldGain;  // GL's world overbright (colorparams), hwrtworldgain
+    float shadowSelf; // 0 none, 1 sun, 2 +always-eval omni, 3 +finite, 4 +sky
+    float glowLayers; // world glow array layers; 0 = no glow
+    mat4 prevViewProj; // last dispatch's world -> clip, for the skyvis history
+    vec3 prevCam;      // and where the camera stood when it wrote that history
+    float skyAlpha;    // 0 off, 1 seed (write only), else the new estimate's weight
+    float diffFilter;  // 0 textureLod 0 (old), 1 textureGrad from pixel UV footprint,
+                       // >= 4: footprint + bias, 8*m + bias with m = 1 + aniso + 2*texel (texel 0-2)
+                       // (see sampleWorldDiff and lights.cpp)
+    float diffVis;     // 0 play, 1 albedo, 2 lighting, 3 lod heatmap
+    float skyStable;   // 0 pixel+frame RNG, 1 pixel only (no frame)
+    // Packed: bit0 hold, bit1 bilinear history, bits2-3 visdbg, bit4 per-pixel age,
+    // bit5 NRD (skip skyage spatial/temporal; write raw skyvis + guides).
+    // bits6-9 hwrtnrddbg, bit12 hidden-retry (default on).
+    float diffPad1;
+    mat4 nrdWorldToView;
+    mat4 nrdWorldToViewPrev;
+    mat4 nrdViewToClip;
+    mat4 nrdViewToClipPrev;
+    vec4 nrdHit; // A, B, C, denoisingRange
+    vec4 soft;   // extended sources: tan(sun angular radius), rays, pattern bits, adaptive
+    vec4 soft2;  // rays by apparent size: radians of diameter per extra ray (0 off), fewest rays, spare, spare
+    vec4 soft3;  // optimised rays: smallest contribution, tan of the smallest half-angle, temporal weight, filter radius scale
+};
+struct Light { vec3 pos; float radius; vec3 color; float flags; };
+// Same buffer as hitlight.comp; stage 2 appends one word per lamp after the 256
+// lamp slots: bit 0 = the first loop evaluates it (radius 0 within the first
+// 16, or a glow within the first 96, counted in index order exactly as that
+// loop counts them), bit 1 = it is a finite lamp the nearest-N loop may elect.
+const int MAXLIGHTS = 256;
+const uint KIND_ALWAYS = 1u;
+const uint KIND_NEAR = 2u;
+// Traced reflections: the water planes ride behind the lamp table and the
+// kind words (pos = min x, min y, surface z; radius = max x; color = max y,
+// group, first rectangle; flags = rectangle count; the box has the margin),
+// then the rectangles of the surfaces GL draws (min x, min y, max x, max y).
+const int REFL_MAXPLANES = 16;
+const int REFL_MAXRECTS = 512;
+layout(std430, binding = 6) readonly buffer Lights {
+    LightEnv env;
+    Light l[MAXLIGHTS];
+    uint kind[MAXLIGHTS];
+    Light water[REFL_MAXPLANES];
+#ifndef HWRT_NO_REFL
+    vec4 waterRect[REFL_MAXRECTS];
+    // Animated water (water.cpp hwrtwaterwaves): [0] x on, y grid n,
+    // z 1/tile, w slope scale; [1] second layer rotation cos/sin, 1/its
+    // tile, weight; [2] x far fade, y shore depth; then the n*n slopes of
+    // the tile (x, y), row by row.
+    vec4 waveParams[3];
+    vec2 waveSlope[];
+#endif
+} lights;
+
+// Per-BLAS attributes, reached by device address so each rest-pose / animated
+// slot keeps its own buffers. customIndex indexes this table; slot 0 is unused
+// (the world) and holds the uploaded skin-layer count in ntris.
+struct ModelVert { vec2 tc; vec2 pad0; vec3 n; float pad1; vec3 pos; float pad2; };
+layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer ModelVertRef { ModelVert v[]; };
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ModelIdxRef { uint i[]; };
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ModelTriRef { uint t[]; };
+// Addresses as uvec2 so the shader does not need shaderInt64. Same 8-byte
+// little-endian layout as the CPU's uint64_t device addresses.
+struct ModelGeom {
+    uvec2 verts;
+    uvec2 indices;
+    uvec2 tris;
+    uint ntris;
+    uint flags;
+};
+layout(std430, binding = 7) readonly buffer ModelGeoms { ModelGeom g[]; } geoms;
+layout(binding = 8) uniform sampler2DArray skins;
+// GL's window depth after the world and both model passes, copied into the
+// shared R32F. Only read when TEST_GLDEPTH is set, which the CPU only sets
+// once the copy for this frame has succeeded.
+layout(binding = 9, r32f) uniform readonly image2D gdepth;
+// World glowmaps (TEX_GLOW). Layer index + RGB scale live in ShadeTri.w.
+// Missing glow binds the diffuse array as a dummy; the shader never samples
+// it when the layer byte is 0xFF.
+layout(binding = 10) uniform sampler2DArray glows;
+layout(binding = 11) uniform samplerCube mdlenv;
+// Lightmaps for texlayer blend alpha only. Lighting itself does not use the bake.
+layout(binding = 12) uniform sampler2DArray lightmaps;
+// The skyvis history, alternating: 13 is what the previous dispatch wrote, 14 is
+// what this one writes. rgb is the hit position relative to the camera of the
+// frame that wrote it, a is the running visibility (negative = no entry).
+layout(binding = 13, rgba16f) uniform readonly image2D skyhistin;
+layout(binding = 14, rgba16f) uniform writeonly image2D skyhistout;
+// Matching ping-pong for the per-pixel sample count. 0 = no entry. Integers
+// 1..N are exact in r16f. Same lifetime as the vis pair: seed, bilinear of
+// geom-valid taps (min age), miss/reset back to 1, destroy on resize.
+layout(binding = 15, r16f) uniform readonly image2D skyagein;
+layout(binding = 16, r16f) uniform writeonly image2D skyageout;
+// NRD inputs + composition payloads. 1x1 dummies when NRD is off.
+layout(binding = 17, rgba16f) uniform writeonly image2D nrddiff;
+layout(binding = 18, r32f) uniform writeonly image2D nrdviewz;
+layout(binding = 19, rgba16) uniform writeonly image2D nrdnormal;
+layout(binding = 20, rgba16f) uniform writeonly image2D nrdmv;
+layout(binding = 21, rgba16f) uniform writeonly image2D nrdp0;
+layout(binding = 22, rgba16f) uniform writeonly image2D nrdp1;
+layout(binding = 23, rgba16f) uniform writeonly image2D nrdp2;
+layout(binding = 24, rgba16f) uniform writeonly image2D nrdp3;
+// Sky-ray blue noise (hwrtskybluenoise): 128x128 words from
+// tools/generate-hwrt-bluenoise.py, two independent void-and-cluster masks,
+// u1 in the low 16 bits and u2 in the high 16. Uploaded once; only read when
+// bit 13 of the sky flags says the tile is live.
+layout(std430, binding = 25) readonly buffer SkyBlueNoise { uint v[]; } skybn;
+const uint SKYBN_SIZE = 128u;
+// Traced reflections (hwrtreflections). 26: the water reflection seen at each
+// pixel, shared with GL's water shader (layout in waterReflection()). 27: the
+// sky cubemap an escaping reflection ray sees. 28: the normal maps of the
+// world faces that have a spec or envmap shader (layer in ShadeTri.x).
+layout(binding = 26, rgba32f) uniform writeonly image2D reflout;
+layout(binding = 27) uniform samplerCube skyenv;
+layout(binding = 28) uniform sampler2DArray normals;
+// The world diffuse again (same image as binding 5) through an anisotropic
+// sampler, for hwrtdiffmip 2. Plain sampler when the device has no anisotropy.
+layout(binding = 29) uniform sampler2DArray diffusesAniso;
+// NRD SIGMA for the soft shadows (SOFT_SIGMA only; trace.cpp binds 1x1 images otherwise): 30 the extended lamps'
+// light before their shadows (rgb) and the sun's N.L (a), 31 the penumbra radius, 32 the noisy lit fractions.
+layout(binding = 30, rgba16f) uniform writeonly image2D sigu;
+layout(binding = 31, r16f) uniform writeonly image2D sigpen;
+layout(binding = 32, rgba8) uniform writeonly image2D sigfrac;
+
+layout(push_constant) uniform Params
+{
+    ivec2 size;
+    int mode;
+    int frame;
+    mat4 invcamproj;
+    vec4 origin;   // xyz = camera1->o, w = tmin
+    vec4 range;    // x = tmax, y = diffuse layers, z = hwrtdlights, w = triangle count
+    vec4 lighting; // xyz = ambient/255, w = uploaded light count
+} pc;
+
+const float SHADOW_BIAS = 0.25;
+// Models are a closed mesh with two-sided instances. A 0.25 push along a
+// smoothed vertex normal often starts the shadow ray *inside* the body, so
+// every light (and the sky) self-hits and the player is ambient-only.
+const float MODEL_SHADOW_BIAS = 0.75;
+// Sauer's model shader samples diffuse then does `light.rgb *= 2.0`, and
+// keeps an unlit floor of about 0.29 (lightscale.z). Without both, a player
+// is a near-black blob next to a wall that used the same lights.
+const float MODEL_MINSHADE = 0.29;
+// Sauer's model wrap (glsl.cfg + setshaderparams unlit defaults):
+// lightscale = (0.21, 0.30, 0.29). Replaces the old half-Lambert that
+// fed half the sun to grazing faces and blew rgba8.
+const vec3 MODEL_LIGHTSCALE = vec3(0.21, 0.30, 0.29);
+// modelshader Blinn-Phong exponent (the non-glare path).
+const float MODEL_SPEC_POW = 128.0;
+// The same wrap, for the two light terms that have no direction to feed it:
+// the ambient constant and the sky. glsl.cfg multiplies the WHOLE of
+// lightreaching()'s colour by the wrap, and that colour is ambient plus the
+// bake, so those terms cannot arrive unattenuated. The value is the wrap
+// evaluated at the mean cosine of a cosine-weighted hemisphere, E[n.l] = 2/3:
+// (2/3)*((2/3)*0.21 + 0.30) + 0.29. Derived, not dialled in, so it stays
+// right if MODEL_LIGHTSCALE is ever corrected.
+const float MODEL_AMBWRAP = 0.583;
+// Preview studio key (3dgui: light.dir = (0,-1,2)). In a camera looking
+// along +Y that is -forward + 2*up. Intensity sits under the 1.5 cap so
+// a sunlit player does not clip to white.
+const float MODEL_STUDIO = 1.00;
+// Set in pc.mode above the trace mode number. Push constants are 128 bytes.
+const int MASK_MODELS = 0x100;
+const int SHADE_MODELS = 0x200;
+const int TEST_GLDEPTH = 0x400;
+// Stage 1 HDR. HDR keeps scene radiance in this rgba16f image. HDRPROBE
+// overwrites a fixed rectangle after shading so the values travel through
+// the same image the lighting pass writes.
+const int HDR = 0x800;
+const int HDRPROBE = 0x1000;
+// Traced reflections and world spec. REFL_WATER: trace the water planes
+// packed in lights.water (count in bits 16-20) into reflout. REFL_WORLD:
+// envmapped world faces (colorscale top byte) mix in a traced reflection
+// instead of staying matte. SPEC: the world's spec shaders get their lamp and
+// sun highlights back.
+// Built a second time with HWRT_NO_REFL (tools/compile-hwrt-shaders.py): that
+// variant drops the reflection and world spec code, and trace.cpp uses it when
+// both options are off, so they cost nothing then. Every other line is shared.
+const int REFL_WATER = 0x2000;
+const int REFL_WORLD = 0x4000;
+const int SPEC = 0x8000;
+const int REFL_PLANESHIFT = 16;
+// Performance options. Bits 24-29: reach of the sky rays in 32-unit steps
+// (hwrtskyrange, 0 = to the far plane); a ray that meets nothing that close
+// counts as open sky. RT_ADAPT (hwrtrtadapt): shorter sky rays where it shows
+// least (screen edges, far surfaces, dark textures), RT_FAST: the camera turns
+// or moves fast this frame, shorter still.
+const int SKYRANGE_SHIFT = 24;
+const int RT_ADAPT = 0x200000;
+const int RT_FAST = 0x400000;
+// RT_SKYOPAQUE (hwrtskyopaque): sky rays see alpha-tested models (foliage) as solid
+// and skip smoke, so the hardware never hands a candidate back to the shader.
+const int RT_SKYOPAQUE = 0x800000;
+const float ADAPT_REACH = 1024.0;
+// ShadeTri.x: bits 0-8 diffuse layer, 9-16 specscale x 16, 17 "times the spec
+// map in diffuse.a", 18-25 normal layer (255 = none). All ones = no triangle.
+const uint TRI_LAYER_MASK = 0x1FFu;
+const uint TRI_NORMAL_NONE = 255u;
+// glsl.cfg bumpvariantshader, non-glare exponent.
+const float WORLD_SPEC_POW = 32.0;
+// How far in front of the hit GL has to be before the pixel is handed back.
+// The BLAS is the same geometry the rasteriser draws, so a hit that really is
+// the nearest surface matches to within depth-buffer precision and whatever
+// the CPU-skinned pose drifts from GL's; only a clearly nearer surface is an
+// occluder the TLAS never had. World units, relative to the hit distance.
+const float GLDEPTH_SLACK_REL = 0.015;
+const float GLDEPTH_SLACK_ABS = 0.75;
+const uint GEOM_SHADE = 1u;
+const uint GEOM_FULLBRIGHT = 2u;
+// Instance ray masks, mirroring HWRT_RAYMASK_ in hwrt.h.
+const uint RAYMASK_WORLD = 0x01u;
+const uint RAYMASK_MODEL = 0x02u;
+const uint RAYMASK_SELF  = 0x04u;
+const uint RAYMASK_CASTER = 0x08u;
+const uint RAYMASK_PORTAL = 0x10u;
+const uint RAYMASK_SMOKE = 0x20u;
+// The local player's body in third person (always together with MODEL).
+const uint RAYMASK_LOCAL = 0x40u;
+// Other players, corpses, projectiles, flags, pickups (instead of MODEL).
+const uint RAYMASK_DYN = 0x80u;
+const uint RAYMASK_ALL = 0xFFu;
+// customIndex bit 16 (HWRT_SMOKE_SOFT): a soft smoke puff, bits 8-15 its peak
+// optical depth in 1/128. Never a surface; shadow and sky rays integrate it.
+const uint SMOKE_SOFT = 0x10000u;
+
+// 16x16 so a 5x5 bilateral has interior pixels with a full neighbourhood.
+// 8x8 would average only inside an 8-pixel tile and show as a faint grid.
+shared float sh_sky[16][16];
+shared vec3 sh_n[16][16];
+shared vec3 sh_p[16][16];
+shared float sh_mdl[16][16];
+shared float sh_hit[16][16];
+
+// Geometry table size with the stage 2 cache (HWRT_MAX_GEOMS_CAP in hwrt.h).
+const uint MAXGEOMS = 161u;
+
+// Stage 2 tile culling. The box of every hit the tile will light, then the two
+// ordered lamp lists that can pass a range test somewhere inside it.
+const int MAXSUBGROUPS = 64;
+shared vec3 sh_lo[MAXSUBGROUPS];
+shared vec3 sh_hi[MAXSUBGROUPS];
+shared uint sh_cntA[MAXSUBGROUPS];
+shared uint sh_cntB[MAXSUBGROUPS];
+shared uint sh_listA[MAXLIGHTS];
+shared uint sh_listB[MAXLIGHTS];
+shared uint sh_nA, sh_nB;
+
+// Could a lamp at `pos` reach any point of the box? The margin is relative and
+// absolute, orders of magnitude above the rounding of `length(pos - hit)`, so a
+// lamp is dropped only when every hit of the tile fails its range test anyway.
+bool tileReach(vec3 pos, float radius, vec3 bmin, vec3 bmax)
+{
+    vec3 q = clamp(pos, bmin, bmax);
+    return distance(pos, q) <= radius * 1.0001 + 0.05;
+}
+
+void tileCull(bool reach, vec3 hit, int nlights)
+{
+    vec3 lo = reach ? hit : vec3(1e30);
+    vec3 hi = reach ? hit : vec3(-1e30);
+    lo = subgroupMin(lo);
+    hi = subgroupMax(hi);
+    if(subgroupElect())
+    {
+        sh_lo[gl_SubgroupID] = lo;
+        sh_hi[gl_SubgroupID] = hi;
+    }
+    barrier();
+    vec3 bmin = vec3(1e30), bmax = vec3(-1e30);
+    for(uint s = 0u; s < gl_NumSubgroups; s++)
+    {
+        bmin = min(bmin, sh_lo[s]);
+        bmax = max(bmax, sh_hi[s]);
+    }
+    // One lamp per invocation, in index order across the subgroups.
+    bool full = gl_NumSubgroups * gl_SubgroupSize == 256u;
+    uint li = gl_SubgroupID * gl_SubgroupSize + gl_SubgroupInvocationID;
+    bool inA = false, inB = false;
+    if(full && int(li) < nlights)
+    {
+        uint k = lights.kind[li];
+        float r = lights.l[li].radius;
+        vec3 lp = lights.l[li].pos;
+        if((k & KIND_ALWAYS) != 0u) inA = r <= 0.0 || tileReach(lp, r, bmin, bmax);
+        if((k & KIND_NEAR) != 0u) inB = tileReach(lp, r, bmin, bmax);
+    }
+    uvec4 bA = subgroupBallot(inA);
+    uvec4 bB = subgroupBallot(inB);
+    uint preA = subgroupBallotExclusiveBitCount(bA);
+    uint preB = subgroupBallotExclusiveBitCount(bB);
+    if(subgroupElect())
+    {
+        sh_cntA[gl_SubgroupID] = subgroupBallotBitCount(bA);
+        sh_cntB[gl_SubgroupID] = subgroupBallotBitCount(bB);
+    }
+    barrier();
+    if(full)
+    {
+        uint offA = 0u, offB = 0u, totA = 0u, totB = 0u;
+        for(uint s = 0u; s < gl_NumSubgroups; s++)
+        {
+            if(s < gl_SubgroupID) { offA += sh_cntA[s]; offB += sh_cntB[s]; }
+            totA += sh_cntA[s];
+            totB += sh_cntB[s];
+        }
+        if(inA) sh_listA[offA + preA] = li;
+        if(inB) sh_listB[offB + preB] = li;
+        if(gl_LocalInvocationIndex == 0u) { sh_nA = totA; sh_nB = totB; }
+    }
+    else if(gl_LocalInvocationIndex == 0u)
+    {
+        // Unusual subgroup layout: one invocation builds the same lists in order.
+        uint na = 0u, nb = 0u;
+        for(int i = 0; i < nlights; i++)
+        {
+            uint k = lights.kind[i];
+            float r = lights.l[i].radius;
+            vec3 lp = lights.l[i].pos;
+            if((k & KIND_ALWAYS) != 0u && (r <= 0.0 || tileReach(lp, r, bmin, bmax))) sh_listA[na++] = uint(i);
+            if((k & KIND_NEAR) != 0u && tileReach(lp, r, bmin, bmax)) sh_listB[nb++] = uint(i);
+        }
+        sh_nA = na;
+        sh_nB = nb;
+    }
+    barrier();
+}
+
+uint pcg(uint v)
+{
+    uint state = v * 747796405u + 2891336453u;
+    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
+    return (word >> 22u) ^ word;
+}
+
+float rand01(uint s)
+{
+    return float(pcg(s)) * (1.0 / 4294967296.0);
+}
+
+float modelWrap(float ndotl)
+{
+    return clamp(ndotl * (ndotl * MODEL_LIGHTSCALE.x + MODEL_LIGHTSCALE.y) + MODEL_LIGHTSCALE.z, 0.0, 1.0);
+}
+
+vec3 cosineHemi(vec3 n, inout uint seed)
+{
+    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
+    vec3 t = normalize(cross(up, n));
+    vec3 b = cross(n, t);
+    float u1 = rand01(seed);
+    seed = pcg(seed);
+    float u2 = rand01(seed);
+    seed = pcg(seed);
+    float r = sqrt(u1);
+    float phi = 6.28318530718 * u2;
+    vec3 hemi = vec3(r * cos(phi), r * sin(phi), sqrt(max(1.0 - u1, 0.0)));
+    return normalize(t * hemi.x + b * hemi.y + n * hemi.z);
+}
+
+// cosineHemi's mapping for a sample that did not come from the pcg chain.
+vec3 cosineHemiU(vec3 n, float u1, float u2)
+{
+    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
+    vec3 t = normalize(cross(up, n));
+    vec3 b = cross(n, t);
+    float r = sqrt(u1);
+    float phi = 6.28318530718 * u2;
+    vec3 hemi = vec3(r * cos(phi), r * sin(phi), sqrt(max(1.0 - u1, 0.0)));
+    return normalize(t * hemi.x + b * hemi.y + n * hemi.z);
+}
+
+// The pixel's blue-noise sample as 0.32 fixed point, (value + 0.5) / 65536.
+// Each frame adds the same R2 step (Roberts' plastic-number sequence) to every
+// pixel: a shift mod 1 keeps the tile's spatial layout, while each pixel walks
+// a low-discrepancy sequence over time, so its running mean converges to the
+// same value the pcg rays do. The stable mode keeps frame 0.
+uvec2 skyBlueNoiseBase(ivec2 p, bool stable)
+{
+    uint w = skybn.v[(uint(p.y) % SKYBN_SIZE) * SKYBN_SIZE + (uint(p.x) % SKYBN_SIZE)];
+    uvec2 q = uvec2((w & 0xFFFFu) << 16, w & 0xFFFF0000u) + uvec2(0x8000u);
+    if(!stable) q += uint(pc.frame) * uvec2(3242174889u, 2447445414u);
+    return q;
+}
+
+// Ray s of a pixel: the base shifted by s * (1/2, 1/4), a 4-point lattice, so
+// the pixel's own rays already cover four azimuths and both halves of the
+// radius instead of four independent draws.
+vec3 skyBlueNoiseDir(vec3 n, uvec2 base, int s)
+{
+    uvec2 q = base + uint(s) * uvec2(0x80000000u, 0x40000000u);
+    return cosineHemiU(n, float(q.x) * (1.0 / 4294967296.0), float(q.y) * (1.0 / 4294967296.0));
+}
+
+// Alpha, water, sky and clip surfaces of the WORLD stay out of the BLAS, so
+// a primary ray still goes through grass / water. Tree foliage and CTF flags
+// are in the TLAS as non-opaque geometry: the candidate loop tests skins.a.
+// GL's depth buffer still catches whatever is not traced (grass, world alpha).
+bool glWorldPos(ivec2 p, out vec3 glpos, out float gldist)
+{
+    float z = imageLoad(gdepth, p).r;
+    glpos = vec3(0.0);
+    gldist = -1.0;
+    // 1 is the cleared value: sky, or a pixel GL rasterised nothing into.
+    if(z <= 0.0 || z >= 1.0) return false;
+    vec2 ndcxy = ((vec2(p) + 0.5) / vec2(pc.size)) * 2.0 - 1.0;
+    vec4 h = pc.invcamproj * vec4(ndcxy, z * 2.0 - 1.0, 1.0);
+    glpos = h.xyz / max(h.w, 1e-8);
+    // dir is normalised, so hitT is already a distance from the eye and the
+    // two measures are in the same units.
+    gldist = distance(glpos, pc.origin.xyz);
+    return true;
+}
+
+bool hiddenbygl(ivec2 p, float hitT)
+{
+    vec3 glpos;
+    float gldist;
+    if(!glWorldPos(p, glpos, gldist)) return false;
+    return gldist < hitT - max(GLDEPTH_SLACK_ABS, hitT * GLDEPTH_SLACK_REL);
+}
+
+// Recovered hit must sit on this pixel's GL surface. Same slack as the far
+// reject, measured from gldist (the visible face), not a looser window.
+bool glSurfaceMatch(float hitT, float gldist)
+{
+    if(gldist <= 0.0) return false;
+    return abs(hitT - gldist) <= max(GLDEPTH_SLACK_ABS, gldist * GLDEPTH_SLACK_REL);
+}
+
+// Pixel-centre primary, same convention as main (row 0 = bottom of the GL
+// window). Used only to recover UV derivatives: compute has no implicit dFdx.
+vec3 worldRayDir(ivec2 pix)
+{
+    vec2 uv = (vec2(pix) + 0.5) / vec2(pc.size);
+    vec2 ndc = uv * 2.0 - 1.0;
+    vec4 farh = pc.invcamproj * vec4(ndc, 1.0, 1.0);
+    vec3 farw = farh.xyz / max(farh.w, 1e-8);
+    return normalize(farw - pc.origin.xyz);
+}
+
+vec3 triBarycentric(vec3 p, vec3 a, vec3 b, vec3 c)
+{
+    vec3 v0 = b - a, v1 = c - a, v2 = p - a;
+    float d00 = dot(v0, v0);
+    float d01 = dot(v0, v1);
+    float d11 = dot(v1, v1);
+    float d20 = dot(v2, v0);
+    float d21 = dot(v2, v1);
+    float det = d00 * d11 - d01 * d01;
+    if(abs(det) < 1e-12) return vec3(1.0, 0.0, 0.0);
+    float inv = 1.0 / det;
+    float v = (d11 * d20 - d01 * d21) * inv;
+    float w = (d00 * d21 - d01 * d20) * inv;
+    return vec3(1.0 - v - w, v, w);
+}
+
+vec2 wrapDelta(vec2 d)
+{
+    return d - round(d);
+}
+
+vec2 uvOnPlane(ivec2 pix, vec3 p0, vec3 p1, vec3 p2, vec3 n, vec2 uv0, vec2 uv1, vec2 uv2, vec2 fallback)
+{
+    vec3 rdir = worldRayDir(pix);
+    float denom = dot(n, rdir);
+    if(abs(denom) < 1e-8) return fallback;
+    float t = dot(p0 - pc.origin.xyz, n) / denom;
+    if(t < 1e-4) return fallback;
+    vec3 hit = pc.origin.xyz + rdir * t;
+    vec3 bary = triBarycentric(hit, p0, p1, p2);
+    return uv0 * bary.x + uv1 * bary.y + uv2 * bary.z;
+}
+
+vec3 lodHeat(float lod)
+{
+    float l = clamp(lod, 0.0, 3.0);
+    return vec3(clamp(l - 1.0, 0.0, 1.0), clamp(1.0 - abs(l - 1.0), 0.0, 1.0), clamp(1.0 - l, 0.0, 1.0));
+}
+
+// Grow a UV gradient (one pixel step) to at least minTexels texels of the
+// array, keeping its direction (an anisotropic footprint keeps its long axis).
+vec2 clampGrad(vec2 g, vec2 tsz, float minTexels)
+{
+    float l = length(g * tsz);
+    if(l >= minTexels) return g;
+    if(l < 1e-8) return vec2(minTexels / tsz.x, 0.0);
+    return g * (minTexels / l);
+}
+
+// World diffuse only. Model skins stay on their own sampler/upload path.
+// texlvl: the array level that holds this layer at its own resolution
+// (ShadeTri.x bits 26-28 / 29-31, as.cpp packdifftexellevels).
+vec3 sampleWorldDiff(int layer, vec2 uv, ivec2 pix, vec3 p0, vec3 p1, vec3 p2, vec3 n, vec2 uv0, vec2 uv1, vec2 uv2, uint texlvl, inout float lod)
+{
+    int ndiff = int(pc.range.y);
+    if(ndiff <= 0 || layer < 0 || layer >= ndiff) return vec3(1.0, 0.0, 1.0);
+    vec3 coord = vec3(uv, float(layer));
+    float filt = lights.env.diffFilter;
+    if(filt > 3.5)
+    {
+        // hwrtdiffmip 2: pixel footprint from the neighbour pixels' rays on the
+        // face plane (ray differentials; the same jittered matrix as the primary
+        // ray, at the render resolution), scaled by 2^bias (hwrtdiffmipbias
+        // [+ log2(render/display) when upscaling]), never finer than the
+        // texture's own texels, filtered anisotropically when available.
+        float m = floor((filt + 4.0) / 8.0);
+        float bias = filt - 8.0 * m;
+        int mi = int(m) - 1;
+        bool aniso = (mi & 1) != 0;
+        int texel = mi >> 1;    // 0 off, 1 the texture's own texels, 2 one level finer
+        vec2 gx = wrapDelta(uvOnPlane(pix + ivec2(1, 0), p0, p1, p2, n, uv0, uv1, uv2, uv) - uv);
+        vec2 gy = wrapDelta(uvOnPlane(pix + ivec2(0, 1), p0, p1, p2, n, uv0, uv1, uv2, uv) - uv);
+        float s = exp2(bias);
+        gx *= s;
+        gy *= s;
+        vec2 tsz = vec2(textureSize(diffuses, 0).xy);
+        int clampl = texel == 1 ? int(texlvl) : (texel == 2 ? int(texlvl) - 1 : 0);
+        if(clampl > 0)
+        {
+            float mt = exp2(float(clampl));
+            gx = clampGrad(gx, tsz, mt);
+            gy = clampGrad(gy, tsz, mt);
+        }
+        float lx = length(gx * tsz), ly = length(gy * tsz);
+        float major = max(lx, ly), minor = max(min(lx, ly), 1e-6);
+        lod = aniso ? log2(max(major / min(major / minor, 16.0), 1e-6)) : log2(max(major, 1e-6));
+        if(aniso) return textureGrad(diffusesAniso, coord, gx, gy).rgb;
+        return textureGrad(diffuses, coord, gx, gy).rgb;
+    }
+    bool wantgrad = filt > 0.5 || lights.env.diffVis > 2.5;
+    if(!wantgrad)
+    {
+        lod = 0.0;
+        return textureLod(diffuses, coord, 0.0).rgb;
+    }
+    vec2 uvx = uvOnPlane(pix + ivec2(1, 0), p0, p1, p2, n, uv0, uv1, uv2, uv);
+    vec2 uvy = uvOnPlane(pix + ivec2(0, 1), p0, p1, p2, n, uv0, uv1, uv2, uv);
+    vec2 ddx = wrapDelta(uvx - uv);
+    vec2 ddy = wrapDelta(uvy - uv);
+    ivec3 tsz = textureSize(diffuses, 0);
+    vec2 rho = vec2(length(ddx * vec2(tsz.xy)), length(ddy * vec2(tsz.xy)));
+    lod = log2(max(max(rho.x, rho.y), 1e-6));
+    if(lights.env.diffFilter > 0.5)
+        return textureGrad(diffuses, coord, ddx, ddy).rgb;
+    return textureLod(diffuses, coord, 0.0).rgb;
+}
+
+// Non-opaque BLAS triangles (MESH_ALPHA) arrive as candidates. Sample the
+// skin alpha and keep the texel if it is at least mdlalphatest. Opaque
+// geometry never calls this: it commits in hardware. Missing skin (overflow)
+// refuses the candidate so we do not paint a solid panel.
+bool alphaTexel(uint custom, uint prim, uint geomid, vec2 bary)
+{
+    if((custom & SMOKE_SOFT) != 0u) return false;
+    uint geom = custom & 0xFFu;
+    uint opac = (custom >> 8) & 0xFFu;
+    if(geom == 0u) return true;
+    if(geom >= MAXGEOMS) return false;
+    // Smoke puffs pack 1-255 here. A grey sprite is not a solid wall: keep
+    // this ray with probability opac/255 so the shadow thins as the trail
+    // fades. 0 means a normal model (no extra channel).
+    if(opac != 0u)
+    {
+        uint seed = pcg(prim * 747796405u + custom + uint(bary.x * 4096.0) + uint(bary.y * 7919.0));
+        return rand01(seed) * 255.0 < float(opac);
+    }
+    ModelGeom g = geoms.g[nonuniformEXT(geom)];
+    uint nopaque = g.flags >> 2u;
+    uint trii = prim + (geomid != 0u ? nopaque : 0u);
+    if((g.flags & GEOM_SHADE) == 0u || (g.verts.x == 0u && g.verts.y == 0u) ||
+       (g.indices.x == 0u && g.indices.y == 0u) || (g.tris.x == 0u && g.tris.y == 0u) ||
+       trii >= g.ntris)
+        return false;
+    ModelVertRef mv = ModelVertRef(g.verts);
+    ModelIdxRef mi = ModelIdxRef(g.indices);
+    ModelTriRef mt = ModelTriRef(g.tris);
+    uint i0 = mi.i[trii * 3u + 0u];
+    uint i1 = mi.i[trii * 3u + 1u];
+    uint i2 = mi.i[trii * 3u + 2u];
+    ModelVert v0 = mv.v[i0];
+    ModelVert v1 = mv.v[i1];
+    ModelVert v2 = mv.v[i2];
+    float w = 1.0 - bary.x - bary.y;
+    vec2 tc = v0.tc * w + v1.tc * bary.x + v2.tc * bary.y;
+    float cutoff = v0.pad1;
+    if(cutoff <= 0.0) return true;
+    uint packed = mt.t[trii];
+    uint layer = packed & 255u;
+    uint nskin = geoms.g[0].ntris;
+    if(layer == 255u || nskin == 0u || layer >= nskin) return false;
+    return texture(skins, vec3(tc, float(layer))).a >= cutoff;
+}
+
+bool occluded(vec3 origin, vec3 dir, float tmax, uint mask, uint skipInst)
+{
+    rayQueryEXT sq;
+    float tmin = 0.01;
+    float tfar = max(tmax, tmin + 0.001);
+    if(mask == 0u) mask = RAYMASK_ALL;
+    // World-only and world+portal rays skip foliage any-hit: walls (and the
+    // punched teleporter rim) still block, the alpha canopy does not.
+    // OpaqueEXT lets hardware terminate. Sun / ordinary lamps keep CASTER
+    // in the mask so they still take the any-hit path.
+    bool skipalpha = (mask & ~(RAYMASK_WORLD | RAYMASK_MODEL | RAYMASK_DYN | RAYMASK_PORTAL)) == 0u;
+    uint rflags = gl_RayFlagsTerminateOnFirstHitEXT;
+    if(skipalpha) rflags |= gl_RayFlagsOpaqueEXT;
+    rayQueryInitializeEXT(sq, tlas, rflags, mask, origin, tmin, dir, tfar);
+    if(skipalpha)
+    {
+        rayQueryProceedEXT(sq);
+        return rayQueryGetIntersectionTypeEXT(sq, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
+    }
+    while(rayQueryProceedEXT(sq))
+    {
+        if(rayQueryGetIntersectionTypeEXT(sq, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
+        {
+            uint iid = uint(rayQueryGetIntersectionInstanceIdEXT(sq, false));
+            if(iid == skipInst) continue;
+            uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(sq, false));
+            uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(sq, false));
+            uint geomid = uint(rayQueryGetIntersectionGeometryIndexEXT(sq, false));
+            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(sq, false);
+            if(alphaTexel(custom, prim, geomid, bary))
+                rayQueryConfirmIntersectionEXT(sq);
+        }
+    }
+    return rayQueryGetIntersectionTypeEXT(sq, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
+}
+
+// Same as occluded, but returns committed T or a negative miss. Used as the
+// NRD hit-distance guide, not as a substitute for skyvis.
+// TerminateOnFirstHit: this is the first committed intersection, not a
+// certified closest-surface distance once any-hit/alpha candidates are in
+// play. Opaque-only traces (OpaqueEXT) commit the closest opaque hit.
+float occludedT(vec3 origin, vec3 dir, float tmax, uint mask, uint skipInst)
+{
+    rayQueryEXT sq;
+    float tmin = 0.01;
+    float tfar = max(tmax, tmin + 0.001);
+    if(mask == 0u) mask = RAYMASK_ALL;
+    bool skipalpha = (mask & ~(RAYMASK_WORLD | RAYMASK_MODEL | RAYMASK_DYN | RAYMASK_PORTAL)) == 0u;
+    uint rflags = gl_RayFlagsTerminateOnFirstHitEXT;
+    if(skipalpha) rflags |= gl_RayFlagsOpaqueEXT;
+    rayQueryInitializeEXT(sq, tlas, rflags, mask, origin, tmin, dir, tfar);
+    if(skipalpha)
+    {
+        rayQueryProceedEXT(sq);
+        if(rayQueryGetIntersectionTypeEXT(sq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
+            return rayQueryGetIntersectionTEXT(sq, true);
+        return -1.0;
+    }
+    while(rayQueryProceedEXT(sq))
+    {
+        if(rayQueryGetIntersectionTypeEXT(sq, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
+        {
+            uint iid = uint(rayQueryGetIntersectionInstanceIdEXT(sq, false));
+            if(iid == skipInst) continue;
+            uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(sq, false));
+            uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(sq, false));
+            uint geomid = uint(rayQueryGetIntersectionGeometryIndexEXT(sq, false));
+            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(sq, false);
+            if(alphaTexel(custom, prim, geomid, bary))
+                rayQueryConfirmIntersectionEXT(sq);
+        }
+    }
+    if(rayQueryGetIntersectionTypeEXT(sq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
+        return rayQueryGetIntersectionTEXT(sq, true);
+    return -1.0;
+}
+
+// Optical depth of one soft smoke puff along the shadow segment [t0, t1].
+// Density (1 - r^2/R^2)^2 around the centre c: zero with a flat slope at the
+// rim, so the shadow has no edge, and its line integral has a closed form.
+// With a = 1 - d^2/R^2 (d = ray-to-centre distance) and u = (t - tc)/R, the
+// integral is tauc * 15/16 * F(u), F(u) = a^2 u - 2a u^3/3 + u^5/5, which
+// gives tauc for a full chord through the centre. Clipping u to the segment
+// handles a receiver or a lamp inside the smoke. tri: the candidate came from
+// the sphere mesh (two per puff): keep the entry, or the exit from inside.
+float smokeTau(vec3 c, float R, uint custom, vec3 o, vec3 d, float t0, float t1, bool tri, float tcand)
+{
+    vec3 oc = o - c;
+    float tc = -dot(oc, d);
+    float oc2 = dot(oc, oc);
+    float R2 = R * R;
+    float a = 1.0 - (oc2 - tc * tc) / R2;
+    if(a <= 0.0) return 0.0;
+    if(tri && tcand > tc && oc2 >= R2) return 0.0;
+    float ra = sqrt(a);
+    float u0 = clamp((t0 - tc) / R, -ra, ra);
+    float u1 = clamp((t1 - tc) / R, -ra, ra);
+    float f0 = u0 * (a * a - u0 * u0 * (2.0 * a / 3.0 - u0 * u0 * 0.2));
+    float f1 = u1 * (a * a - u1 * u1 * (2.0 * a / 3.0 - u1 * u1 * 0.2));
+    float tauc = float((custom >> 8u) & 0xFFu) * (1.0 / 128.0);
+    return tauc * (15.0 / 16.0) * max(f1 - f0, 0.0);
+}
+
+// occluded() / occludedT() with soft smoke: 0 when a surface blocks, else the
+// transmittance exp(-sum of puff optical depths) along the ray, 1 when no puff
+// is crossed. hitT: the committed distance, or negative on a miss.
+float shadowVis(vec3 origin, vec3 dir, float tmax, uint mask, uint skipInst, out float hitT)
+{
+    hitT = -1.0;
+    rayQueryEXT sq;
+    float tmin = 0.01;
+    float tfar = max(tmax, tmin + 0.001);
+    if(mask == 0u) mask = RAYMASK_ALL;
+    bool skipalpha = (mask & ~(RAYMASK_WORLD | RAYMASK_MODEL | RAYMASK_PORTAL)) == 0u;
+    uint rflags = gl_RayFlagsTerminateOnFirstHitEXT;
+    if(skipalpha) rflags |= gl_RayFlagsOpaqueEXT;
+    rayQueryInitializeEXT(sq, tlas, rflags, mask, origin, tmin, dir, tfar);
+    if(skipalpha)
+    {
+        rayQueryProceedEXT(sq);
+        if(rayQueryGetIntersectionTypeEXT(sq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
+        {
+            hitT = rayQueryGetIntersectionTEXT(sq, true);
+            return 0.0;
+        }
+        return 1.0;
+    }
+    float tau = 0.0;
+    while(rayQueryProceedEXT(sq))
+    {
+        uint ctype = rayQueryGetIntersectionTypeEXT(sq, false);
+        if(ctype == gl_RayQueryCandidateIntersectionAABBEXT)
+        {
+            mat4x3 m = rayQueryGetIntersectionObjectToWorldEXT(sq, false);
+            uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(sq, false));
+            if((custom & SMOKE_SOFT) != 0u)
+                tau += smokeTau(m[3], length(m[0]), custom, origin, dir, tmin, tfar, false, 0.0);
+            continue;
+        }
+        if(ctype == gl_RayQueryCandidateIntersectionTriangleEXT)
+        {
+            uint iid = uint(rayQueryGetIntersectionInstanceIdEXT(sq, false));
+            if(iid == skipInst) continue;
+            uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(sq, false));
+            if((custom & SMOKE_SOFT) != 0u)
+            {
+                mat4x3 m = rayQueryGetIntersectionObjectToWorldEXT(sq, false);
+                float tcand = rayQueryGetIntersectionTEXT(sq, false);
+                tau += smokeTau(m[3], length(m[0]), custom, origin, dir, tmin, tfar, true, tcand);
+                continue;
+            }
+            uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(sq, false));
+            uint geomid = uint(rayQueryGetIntersectionGeometryIndexEXT(sq, false));
+            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(sq, false);
+            if(alphaTexel(custom, prim, geomid, bary))
+                rayQueryConfirmIntersectionEXT(sq);
+        }
+    }
+    if(rayQueryGetIntersectionTypeEXT(sq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
+    {
+        hitT = rayQueryGetIntersectionTEXT(sq, true);
+        return 0.0;
+    }
+    return tau > 0.0 ? exp(-tau) : 1.0;
+}
+
+int skyPackFlags()
+{
+    return int(lights.env.diffPad1 + 0.5);
+}
+
+// Extended light sources (lights.cpp: hwrtsunsize, hwrtlampsize, hwrtglowsize,
+// hwrtsoftrays, hwrtsoftnoise). The pixel's two pattern numbers in [0, 1):
+// fixed per pixel (a still dither the anti-aliasing resolves), or shifted by
+// the R2 step every frame (soft.z bit 0) so the temporal anti-aliasing averages
+// the penumbra; from the sky's blue-noise tile (bit 1, when it is loaded),
+// offset so the two patterns do not line up, else from a hash.
+vec2 softBase()
+{
+    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
+    int mode = int(lights.env.soft.z + 0.5);
+    bool perframe = (mode & 1) != 0;
+    uvec2 b;
+    if((mode & 2) != 0 && (skyPackFlags() & 8192) != 0)
+        b = skyBlueNoiseBase(q + ivec2(37, 71), !perframe);
+    else
+    {
+        uint h = pcg(uint(q.x) * 1973u + uint(q.y) * 9277u + 26699u);
+        b = uvec2(h, pcg(h));
+        if(perframe) b += uint(pc.frame) * uvec2(3242174889u, 2447445414u);
+    }
+    return vec2(b >> 8u) * (1.0 / 16777216.0);
+}
+
+// Sample k of n on the unit disc: stratified radius, golden-angle turns.
+vec2 softDisc(vec2 u, int k, int n)
+{
+    float r = sqrt((float(k) + u.y) / float(n));
+    float a = 6.28318530718 * (u.x + float(k) * 0.61803398875);
+    return vec2(cos(a), sin(a)) * r;
+}
+
+// Extended sources are compiled in only for the pipeline that needs them
+// (specialization constant 0, trace.cpp): with every size at 0 the lighting
+// pass runs the shader without their code, as a bigger shader is slower even
+// when its extra branches are never taken.
+layout(constant_id = 0) const bool SOFT_SOURCES = false;
+// Optimised extended sources (lights.cpp hwrtsoftopt), each compiled in only for the
+// pipeline that uses it (trace.cpp): every piece of code the pass carries slows it down, even unused.
+// SOFT_LEAN: one ray per source per pixel to a point of the source that changes with the pixel (blue noise) and
+// with every frame: the code of a point source with a moved target. The prototype's loop of rays stays the
+// SOFT_SOURCES && !SOFT_LEAN pipeline (hwrtsoftopt 0).
+// SOFT_DETECT: the source's other rays (hwrtsoftrays, by apparent size) only where the first rays of a subgroup
+// of pixels (a 16x2 strip) on the same source disagree, i.e. where a penumbra or a shadow edge crosses it.
+// SOFT_FILTER: the extended sources' light kept apart as a lit fraction, filtered over the 5x5 pixels of the same
+// surface with a radius from the estimated penumbra width, then multiplied back.
+// SOFT_TEMPORAL: with the filter and NRD on, the fraction also averaged over the last frames on the same surface,
+// held inside the range of this frame's neighbouring pixels.
+layout(constant_id = 1) const bool SOFT_LEAN = false;
+layout(constant_id = 2) const bool SOFT_DETECT = false;
+layout(constant_id = 3) const bool SOFT_FILTER = false;
+layout(constant_id = 4) const bool SOFT_TEMPORAL = false;
+// SOFT_SUN_RAYS, SOFT_LAMP_RAYS (lights.cpp hwrtsoftshadowrays): with SOFT_LEAN alone, the rays per pixel for the
+// sun and for each extended lamp. 1 is the single moved ray above; more go to as many points of the source's disc,
+// spread over it (stratified radius, golden-angle turns) and still moved with the pixel and every frame, for a
+// smoother penumbra at the cost of each ray. A pipeline per count (trace.cpp), so 1 keeps the code of before; the
+// lamps keep 1 while no lamp is extended, as their loop of rays costs the whole pass some speed.
+layout(constant_id = 5) const int SOFT_SUN_RAYS = 1;
+layout(constant_id = 6) const int SOFT_LAMP_RAYS = 1;
+// SOFT_SIGMA_ON (lights.cpp hwrtsoftsigma, with NRD on): with SOFT_LEAN alone, the extended sources' light kept apart
+// as lit fractions (sun; lamps per colour) with a penumbra radius, written for NRD SIGMA (bindings 30-32) instead of
+// being added to the direct light the compose pass gets; the compose pass adds it back, denoised, before the
+// max(sun + lamps, sky) of the bake. Its own pipeline (trace.cpp), so the others keep their code.
+layout(constant_id = 7) const bool SOFT_SIGMA_ON = false;
+const bool SOFT_OLD = SOFT_SOURCES && !SOFT_LEAN;
+const bool SOFT_NEW = SOFT_SOURCES && SOFT_LEAN;
+const bool SOFT_RATIO = SOFT_NEW && SOFT_FILTER;
+const bool SOFT_SIGMA = SOFT_NEW && SOFT_SIGMA_ON && !SOFT_DETECT && !SOFT_FILTER;
+
+// Shadow rays per extended source, and whether they run adaptively: with 4 or
+// more, the two outermost samples go first and, when they agree, the pixel is
+// taken as fully lit or fully shadowed and the other rays are skipped, so only
+// the penumbra pays for every ray (soft.w).
+int softRayCount() { return clamp(int(lights.env.soft.y + 0.5), 1, 16); }
+// The rays for a source seen under the angle a (diameter / distance, radians).
+int softRayCountFor(float a)
+{
+    int nmax = softRayCount();
+    if(lights.env.soft2.x <= 0.0) return nmax;
+    int nmin = clamp(int(lights.env.soft2.y + 0.5), 1, nmax);
+    return clamp(nmin + int(a / lights.env.soft2.x), nmin, nmax);
+}
+bool softAdaptive(int nr) { return lights.env.soft.w > 0.5 && nr >= 4; }
+// SOFT_RATIO: the sun's light before its shadow and its lit fraction; the extended lamps' light before and
+// after their shadows; the widest penumbra estimated from an occluded ray here (world units, -1 none).
+vec3 gSunU = vec3(0.0);
+float gSunV = -1.0;
+vec3 gLampU = vec3(0.0);
+vec3 gLampV = vec3(0.0);
+float gPenW = -1.0;
+// SOFT_SIGMA: the sun's N.L; the mean distance to what stopped the rays of the last softRays() (-1 none) and to what
+// stopped the current lamp; the penumbra radius NRD expects (65504: no ray stopped) for the sun and for the brightest
+// extended lamp here (gSigLampL its light). SIGMA gets one radius per pixel: that of the brighter of the two, as a
+// faint source in its umbra must not set the blur of the main one (NRD README: driven by the most important light).
+float gSunNdl = 0.0;
+float gRayT = -1.0;
+float gOccT = -1.0;
+float gSigSunPen = 65504.0;
+float gSigLampPen = 65504.0;
+float gSigLampL = 0.0;
+float sigmaRadius(float r) { return clamp(r, 1e-4, 32768.0); }
+
+// SOFT_NEW: the lit fraction of one source from sorigin. Lamp: rays to pos + disc offsets of radius sr, each as
+// long as the distance minus slack. Sun (lamp false): along pos + disc offsets of radius sr = tan of the angular
+// radius, up to tmax. ext false: one ray to the centre (a point source, or one too faint or too small here).
+// nr: the rays SOFT_DETECT may use; key: the source (lamp index, -1 the sun) for its subgroup test; kd: the
+// lamp's kind word (a teleporter ring's disc lies in the ring's plane).
+float softLean(vec3 sorigin, vec3 pos, bool lamp, bool ext, float sr, float dist, vec3 ldir, int nr, int key, uint mask, uint skipInst, float slack, float tmax, uint kd)
+{
+    vec3 tx = vec3(0.0), ty = vec3(0.0);
+    vec2 u = vec2(0.0);
+    if(ext)
+    {
+        vec3 up = abs(ldir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
+        tx = normalize(cross(up, ldir));
+        ty = cross(ldir, tx) * sr;
+        tx *= sr;
+        if((kd & 4u) != 0u)
+        {
+            float a = float((kd >> 8u) & 255u) * (6.28318530718 / 256.0);
+            tx = vec3(-sin(a), cos(a), 0.0) * sr;
+            ty = vec3(0.0, 0.0, sr);
+        }
+        u = softBase();
+    }
+    int n = (SOFT_DETECT && ext) ? nr : 1;
+    float vis = 0.0, first = 0.0, tbsum = 0.0;
+    int nocc = 0;
+    for(int j = 0; j < n; j++)
+    {
+        if(SOFT_DETECT && j == 1)
+        {
+            // Every pixel of the strip on this source saw the same with its first ray: no penumbra here.
+            if(subgroupAllEqual(key) && subgroupAll(abs(first - subgroupBroadcastFirst(first)) < 0.02)) { n = 1; break; }
+        }
+        vec2 o = ext ? softDisc(u, j, n) : vec2(0.0);
+        vec3 d;
+        float len;
+        if(lamp)
+        {
+            d = pos + tx * o.x + ty * o.y - sorigin;
+            float dl = length(d);
+            d /= dl;
+            len = dl - slack;
+        }
+        else
+        {
+            d = ext ? normalize(pos + tx * o.x + ty * o.y) : pos;
+            len = tmax;
+        }
+        float vt = -1.0;
+        float v = len <= 0.02 ? 1.0 : shadowVis(sorigin, d, len, mask, skipInst, vt);
+        if(SOFT_RATIO && vt > 0.0) { tbsum += vt; nocc++; }
+        vis += v;
+        if(SOFT_DETECT && j == 0) first = v;
+    }
+    // Penumbra width here for an occluder at the mean hit distance (similar triangles).
+    if(SOFT_RATIO && ext && nocc > 0)
+    {
+        float tb = tbsum / float(nocc);
+        gPenW = max(gPenW, lamp ? 2.0 * sr * tb / max(dist - tb, 0.05 * dist) : 2.0 * sr * tb);
+    }
+    return vis / float(n);
+}
+
+// SOFT_NEW without the optional parts: where this pixel's single ray goes this frame, pos + a point of the disc of
+// radius sr facing ldir (a teleporter ring's disc in the ring's plane, kind bit 2). For the sun, pos = its
+// direction and sr = tan of its angular radius: the result is a direction to normalise. Kept this small on
+// purpose: it is all the soft pipeline adds to a point source, so the pass keeps the point sources' speed.
+vec3 softTarget(vec3 pos, float sr, vec3 ldir, uint kd)
+{
+    vec2 o = softDisc(softBase(), 0, 1) * sr;
+    vec3 tx, ty;
+    if((kd & 4u) != 0u)
+    {
+        float a = float((kd >> 8u) & 255u) * (6.28318530718 / 256.0);
+        tx = vec3(-sin(a), cos(a), 0.0);
+        ty = vec3(0.0, 0.0, 1.0);
+    }
+    else
+    {
+        vec3 up = abs(ldir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
+        tx = normalize(cross(up, ldir));
+        ty = cross(ldir, tx);
+    }
+    return pos + tx * o.x + ty * o.y;
+}
+// SOFT_SUN_RAYS / SOFT_LAMP_RAYS > 1: the lit fraction of an extended lamp (pos, disc radius sr facing ldir, kind
+// word kd) from n rays to points of its disc, each as long as its distance minus slack; bodymask (not 0): the
+// second ray against the bodies, along each ray the world left clear. Sun (lamp false): pos = its direction,
+// sr = tan of its angular radius, rays up to tmax.
+float softRays(int n, vec3 sorigin, vec3 pos, bool lamp, float sr, vec3 ldir, uint kd, float slack, float tmax, uint mask, uint bodymask, uint skipInst)
+{
+    vec3 tx, ty;
+    if((kd & 4u) != 0u)
+    {
+        float a = float((kd >> 8u) & 255u) * (6.28318530718 / 256.0);
+        tx = vec3(-sin(a), cos(a), 0.0);
+        ty = vec3(0.0, 0.0, 1.0);
+    }
+    else
+    {
+        vec3 up = abs(ldir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
+        tx = normalize(cross(up, ldir));
+        ty = cross(ldir, tx);
+    }
+    vec2 u = softBase();
+    float vis = 0.0;
+    float tsum = 0.0;
+    int nhit = 0;
+    for(int k = 0; k < n; k++)
+    {
+        vec2 o = softDisc(u, k, n) * sr;
+        vec3 d = pos + tx * o.x + ty * o.y;
+        float len = tmax;
+        if(lamp)
+        {
+            d -= sorigin;
+            float dl = length(d);
+            d /= dl;
+            len = dl - slack;
+        }
+        else d = normalize(d);
+        float vt;
+        float v = shadowVis(sorigin, d, len, mask, skipInst, vt);
+        if(v > 0.0 && bodymask != 0u) v *= shadowVis(sorigin, d, len, bodymask, skipInst, vt);
+        if(SOFT_SIGMA && vt > 0.0) { tsum += vt; nhit++; }
+        vis += v;
+    }
+    if(SOFT_SIGMA) gRayT = nhit > 0 ? tsum / float(nhit) : -1.0;
+    return vis / float(n);
+}
+// Ray j of nr: adaptive order nr-1, nr-2, then 0 .. nr-3.
+int softOrder(int j, int nr, bool adapt) { return adapt ? (j < 2 ? nr - 1 - j : j - 2) : j; }
+
+// Smooth normals (hwrtsmoothnormals, bit 14). gFlatN keeps the flat face
+// normal of a world hit whose lighting normal was smoothed; the sky rays use
+// it to stay above the face.
+bool smoothNormalsOn() { return (skyPackFlags() & 16384) != 0; }
+vec3 gFlatN = vec3(0.0, 0.0, 1.0);
+bool gSmoothed = false;
+
+bool skyHistGeomOk(vec4 h, vec3 hp, vec3 n, float hitdist)
+{
+    if(h.w < 0.0) return false;
+    vec3 delta = h.xyz + lights.env.prevCam - hp;
+    float off = abs(dot(delta, n));
+    float along = length(delta - n * dot(delta, n));
+    return off < max(0.5, hitdist * 0.01) && along < max(4.0, hitdist * 0.05);
+}
+
+// World spec (hwrtspecular). glsl.cfg's bump spec shaders add
+// specscale * pow(dot(H, bump), 32) [* the spec map in diffuse.a] to the
+// diffuse before it meets the lightmap, so each light leaves
+// light * N.L * spec on top of the lit texture. The traced lights already
+// carry their own shadow ray; this adds their highlight, with the face's
+// normal map, for every lamp and the sun that reaches the pixel.
+bool gWSpecOn = false;
+vec3 gWSpecN = vec3(0.0, 0.0, 1.0);
+vec3 gWSpecAcc = vec3(0.0);
+
+void addWorldSpec(vec3 ldir, vec3 viewDir, vec3 color)
+{
+    if(!gWSpecOn) return;
+    float ndl = dot(gWSpecN, ldir);
+    if(ndl <= 0.0) return;
+    vec3 H = ldir - viewDir;
+    float hlen = length(H);
+    if(hlen < 1e-6) return;
+    float sp = pow(clamp(dot(gWSpecN, H / hlen), 0.0, 1.0), WORLD_SPEC_POW);
+    gWSpecAcc += color * (ndl * sp);
+}
+
+void addSpec(vec3 ldir, vec3 n, vec3 viewDir, vec3 color, float specMul, inout vec3 specAcc)
+{
+    if(specMul <= 0.0) return;
+    vec3 H = ldir - viewDir;
+    float hlen = length(H);
+    if(hlen < 1e-6) return;
+    H /= hlen;
+    float sp = pow(clamp(dot(n, H), 0.0, 1.0), MODEL_SPEC_POW);
+    specAcc += color * sp * specMul;
+}
+
+// bodymask: a second shadow ray against the bodies and game objects alone
+// (DYN, plus SELF / LOCAL from hwrtshadowself 2), traced only once shmask found
+// the lamp clear. 0 for none. The teleport / lava lamps use it: their world ray
+// stays opaque and skips the mapmodel foliage, and this one honours skipInst.
+void addOmni(int i, vec3 hit, vec3 n, vec3 sorigin, uint shmask, uint bodymask, uint skipInst, bool wrap, inout vec3 acc, vec3 viewDir, float specMul, inout vec3 specAcc)
+{
+    vec3 toL = lights.l[i].pos - sorigin;
+    float mag = length(toL);
+    float radius = lights.l[i].radius;
+    float flags = lights.l[i].flags;
+    float intensity = 1.0;
+    if(radius > 0.0)
+    {
+        float magh = length(lights.l[i].pos - hit);
+        float x = magh / radius;
+        if(x >= 1.0) return;
+        // Glow / teleport: 1-x^2 keeps mid-range light without raising the
+        // peak. Linear (ordinary lamps) matches the baker.
+        intensity = flags >= 1.5 ? (1.0 - x*x) : (1.0 - x);
+    }
+    vec3 ldir = mag > 1e-4 ? (toL / mag) : n;
+    // flags 2: aura (screens). Sit on a pad that is often buried
+    // in a wall cube, so Lambert would light nothing. Distance only, no
+    // shadow ray. flags 3: always-eval lamp with Lambert and shadow rays
+    // (teleporter, lava). flags 0/1: ordinary lamps.
+    bool aura = flags >= 1.5 && flags < 2.5;
+    float ndotl = 1.0;
+    if(!aura)
+    {
+        ndotl = dot(n, ldir);
+        if(wrap) ndotl = modelWrap(ndotl);
+        else ndotl = max(ndotl, 0.0);
+        // Teleport / lava sit low over a pad: hard Lambert leaves the floor
+        // black a few metres out. A bit of wrap fills the room; walls still
+        // block because the shadow ray runs after this.
+        if(flags >= 2.5) ndotl = ndotl * 0.65 + 0.35;
+        if(ndotl <= 0.0) return;
+    }
+    if(intensity * ndotl < 0.02) return;
+
+    // vis: 0 behind a surface, below 1 through weapon smoke, else 1.
+    float vis = 1.0;
+    bool wantshadow = flags < 0.5 || flags >= 2.5;
+    float slack = flags >= 2.5 ? 0.35 : 0.01;
+    bool extended = false;
+    float extsr = 0.0;
+    if(wantshadow && mag > slack + 0.02)
+    {
+        // Extended source: radius / 128 rides in the flags of a shadowed lamp
+        // (0 + r/128) or a teleporter / lava lamp (3 + r/128).
+        float sr = flags < 0.5 ? flags * 128.0 : (flags - 3.0) * 128.0;
+        // The second ray against the bodies (bodymask) aims where the world ray did.
+        vec3 bdir = ldir;
+        float bdist = mag - slack;
+        // An unlimited lamp (the baker's old-map sun) far away: at least the
+        // sun's angular size.
+        if(radius <= 0.0 && lights.env.soft.x > 0.0) sr = max(sr, mag * lights.env.soft.x);
+        // Point source: one ray to the centre. Extended: rays to points of a
+        // disc of radius sr facing the hit; a teleporter ring's disc lies in the
+        // ring's plane (kind bit 2, bits 8-15 its normal's angle / 2pi), inside
+        // the hole.
+        if(SOFT_NEW)
+        {
+            // Extended unless it adds less than soft3.x to this pixel or looks smaller than soft3.y (hwrtsoftopt 16).
+            vec3 lc = lights.l[i].color;
+            extended = sr >= 0.05 && intensity * ndotl * max(lc.r, max(lc.g, lc.b)) >= lights.env.soft3.x
+                       && sr >= mag * lights.env.soft3.y;
+            if(SOFT_SIGMA) extsr = sr;
+            if(!SOFT_DETECT && !SOFT_FILTER && SOFT_LAMP_RAYS > 1 && extended)
+            {
+                vis = softRays(SOFT_LAMP_RAYS, sorigin, lights.l[i].pos, true, sr, ldir, lights.kind[i], slack, 0.0, shmask, bodymask, skipInst);
+                bodymask = 0u;
+                if(SOFT_SIGMA) gOccT = gRayT;
+            }
+            else if(!SOFT_DETECT && !SOFT_FILTER)
+            {
+                vec3 d = (extended ? softTarget(lights.l[i].pos, sr, ldir, lights.kind[i]) : lights.l[i].pos) - sorigin;
+                float dl = length(d);
+                float vt;
+                vis = shadowVis(sorigin, d / dl, dl - slack, shmask, skipInst, vt);
+                if(SOFT_SIGMA) gOccT = vt;
+                bdir = d / dl;
+                bdist = dl - slack;
+            }
+            else
+            {
+                int nr = (extended && SOFT_DETECT) ? softRayCountFor(2.0 * sr / max(mag, 1.0)) : 1;
+                vis = softLean(sorigin, lights.l[i].pos, true, extended, sr, mag, ldir, nr, i, shmask, skipInst, slack, 0.0, lights.kind[i]);
+            }
+        }
+        else if(SOFT_OLD && sr >= 0.05)
+        {
+            int nr = softRayCountFor(2.0 * sr / max(mag, 1.0));
+            bool adapt = softAdaptive(nr);
+            vec3 up = abs(ldir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
+            vec3 tx = normalize(cross(up, ldir));
+            vec3 ty = cross(ldir, tx);
+            uint kd = lights.kind[i];
+            if((kd & 4u) != 0u)
+            {
+                float a = float((kd >> 8u) & 255u) * (6.28318530718 / 256.0);
+                tx = vec3(-sin(a), cos(a), 0.0);
+                ty = vec3(0.0, 0.0, 1.0);
+            }
+            vec2 u = softBase();
+            vis = 0.0;
+            float first = 0.0;
+            for(int j = 0; j < 16; j++)
+            {
+                if(j >= nr) break;
+                vec2 o = softDisc(u, softOrder(j, nr, adapt), nr) * sr;
+                vec3 d = lights.l[i].pos + tx * o.x + ty * o.y - sorigin;
+                float dl = length(d);
+                float vt;
+                float v = dl <= slack + 0.02 ? 1.0 : shadowVis(sorigin, d / dl, dl - slack, shmask, skipInst, vt);
+                vis += v;
+                if(adapt && j == 0) first = v;
+                if(adapt && j == 1 && abs(v - first) < 0.02) { nr = 2; break; }
+            }
+            vis /= float(nr);
+        }
+        else
+        {
+            float vt;
+            vis = shadowVis(sorigin, ldir, mag - slack, shmask, skipInst, vt);
+        }
+        if(vis > 0.0 && bodymask != 0u)
+        {
+            float vt;
+            vis *= shadowVis(sorigin, bdir, bdist, bodymask, skipInst, vt);
+            if(SOFT_SIGMA && vt > 0.0) gOccT = vt;
+        }
+    }
+    // SOFT_RATIO: an extended source's light waits for the filtered lit fraction (after the tile filter).
+    // SOFT_SIGMA: it goes to NRD SIGMA as a lit fraction, with the penumbra radius NRD expects for a local source
+    // (SIGMA_FrontEnd_PackPenumbra: disc diameter 2 sr) if it is the brightest extended lamp here.
+    bool ratio = (SOFT_RATIO || SOFT_SIGMA) && extended;
+    if(ratio)
+    {
+        vec3 c = lights.l[i].color * intensity * ndotl;
+        gLampU += c;
+        gLampV += c * vis;
+        float cl = dot(c, vec3(0.2126, 0.7152, 0.0722));
+        if(SOFT_SIGMA && cl > gSigLampL)
+        {
+            gSigLampL = cl;
+            gSigLampPen = gOccT > 0.0 ? sigmaRadius(extsr * gOccT / max(mag - gOccT, 1e-3)) : 65504.0;
+        }
+    }
+    if(SOFT_SIGMA) gOccT = -1.0;
+    if(vis <= 0.0) return;
+    if(!ratio) acc += lights.l[i].color * intensity * ndotl * vis;
+    if(!aura)
+    {
+        addSpec(ldir, n, viewDir, lights.l[i].color * intensity * vis, specMul, specAcc);
+        // Real lamps only: the glow omnis (teleporters, jump pads, lava) are
+        // RT extras with no highlight in classic lighting.
+#ifndef HWRT_NO_REFL
+        if(flags < 1.5) addWorldSpec(ldir, viewDir, lights.l[i].color * intensity * vis);
+#endif
+    }
+}
+
+// Weapon lights (hwrtdynlights, lights.cpp): muzzle flashes, rockets and grenades
+// in flight, explosions. Packed after every map lamp with flags 4 + source
+// radius / 128 (shadow rays, walls only; soft when the radius is not 0) or 5
+// (no shadow ray), always evaluated by the first loop, never
+// in the nearest-N election, so a flash cannot push a map lamp out of a pixel.
+// GL's dynlight falloff (1 - x^2) times Lambert (the model wrap on models). The
+// shadow ray skips models and foliage: a bot's own body would otherwise eat
+// the flash at its muzzle. No highlight, like GL's dynlights.
+const float DYN_SLACK = 0.35;
+// The weapon light added to one pixel never exceeds this (largest channel),
+// so an explosion next to a wall cannot turn it into an HDR highlight.
+const float DYN_MAX = 1.0;
+
+void addDyn(int i, vec3 hit, vec3 n, vec3 sorigin, uint skipInst, bool wrap, inout vec3 acc)
+{
+    vec3 lp = lights.l[i].pos;
+    float x = length(lp - hit) / lights.l[i].radius;
+    if(x >= 1.0) return;
+    vec3 toL = lp - sorigin;
+    float mag = length(toL);
+    vec3 ldir = mag > 1e-4 ? (toL / mag) : n;
+    float ndotl = dot(n, ldir);
+    ndotl = wrap ? modelWrap(ndotl) : max(ndotl, 0.0);
+    vec3 c = lights.l[i].color * ((1.0 - x*x) * ndotl);
+    if(max(c.r, max(c.g, c.b)) < 0.004) return;
+    float fl = lights.l[i].flags;
+    if(fl < 4.5 && mag > DYN_SLACK + 0.02)
+    {
+        // Source radius in the flags (4 + r/128). r > 0: four rays to points of a
+        // disc of that radius facing the hit, stratified, rotated per pixel (fixed
+        // over time, so the penumbra is a still dither the anti-aliasing resolves
+        // instead of noise that crawls), and the light is the visible fraction.
+        float sr = (fl - 4.0) * 128.0;
+        if(sr < 0.05)
+        {
+            if(occluded(sorigin, ldir, mag - DYN_SLACK, RAYMASK_WORLD | RAYMASK_PORTAL, skipInst)) return;
+        }
+        else
+        {
+            vec3 up = abs(ldir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
+            vec3 tx = normalize(cross(up, ldir));
+            vec3 ty = cross(ldir, tx);
+            uvec2 q = gl_GlobalInvocationID.xy;
+            float rot = rand01(q.x * 1973u + q.y * 9277u + 26699u) * 6.28318530718;
+            float vis = 0.0;
+            for(int k = 0; k < 4; k++)
+            {
+                float a = rot + float(k) * 1.57079632679;
+                float rr = sr * sqrt((float(k) + 0.5) * 0.25);
+                vec3 tgt = lp + (tx * cos(a) + ty * sin(a)) * rr;
+                vec3 d = tgt - sorigin;
+                float dl = length(d);
+                if(dl <= DYN_SLACK + 0.02 || !occluded(sorigin, d / dl, dl - DYN_SLACK, RAYMASK_WORLD | RAYMASK_PORTAL, skipInst))
+                    vis += 0.25;
+            }
+            if(vis <= 0.0) return;
+            c *= vis;
+        }
+    }
+    acc += c;
+}
+
+vec3 dynCap(vec3 c)
+{
+    float m = max(c.r, max(c.g, c.b));
+    return m > DYN_MAX ? c * (DYN_MAX / m) : c;
+}
+
+// HDR stage 1. Players (fullbright models) in HDR are shaded exactly
+// as on an SDR screen (display-encoded colours, SDR caps), clipped at white,
+// then decoded once at the end: their overbright plate and studio fill must
+// not become HDR highlights. The world and the other models keep the HDR path.
+bool gSdrModel = false;
+
+vec3 colorTex(vec3 c)
+{
+    if((pc.mode & HDR) == 0 || gSdrModel) return c;
+    c = max(c, vec3(0.0));
+    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
+}
+
+void storeHdrProbe(ivec2 p)
+{
+    if((pc.mode & HDRPROBE) == 0) return;
+    if(p.x < 0 || p.y < 0 || p.x >= pc.size.x || p.y >= pc.size.y) return;
+    int x0 = pc.size.x - 240;
+    int y0 = pc.size.y - 70;
+    if(x0 < 0 || y0 < 0) return;
+    if(p.x < x0 || p.y < y0 || p.y >= y0 + 48) return;
+    int lx = p.x - x0;
+    float v = -1.0;
+    if(lx >= 8 && lx < 56) v = 0.18;
+    else if(lx >= 64 && lx < 112) v = 1.0;
+    else if(lx >= 120 && lx < 168) v = 4.0;
+    else if(lx >= 176 && lx < 224) v = 16.0;
+    if(v < 0.0) return;
+    imageStore(result, p, vec4(v, v, v, 1.0));
+}
+
+// ---------------------------------------------------------------------------
+// Traced reflections (hwrtreflections): one sharp reflection ray, no denoiser.
+//
+// What the ray hits is coloured without any random sample, so the mirror image
+// cannot sparkle: world faces take albedo x the baked lightmap x colorparams
+// (the classic look of that spot, same units as the traced light), models a
+// small deterministic key (ambient + sun with one shadow ray + radius-0 omnis),
+// an escaping ray the sky cubemap. Texture level comes from a ray cone (pixel
+// angle x distance travelled), so a far wall seen in the water does not alias.
+// ---------------------------------------------------------------------------
+
+// Primary WORLD hit distance of this pixel, set by shadePixel(); 1e30 on a
+// miss or a model hit. A model in front of the water does not stop the water
+// trace: GL may already have moved it (the BLAS is last frame's pose), and a
+// pixel left untraced there would show nothing.
+float gPrimaryT = 1e30;
+
+float reflPixelAngle()
+{
+    ivec2 c = pc.size / 2;
+    return length(worldRayDir(c + ivec2(1, 0)) - worldRayDir(c));
+}
+
+vec3 reflSky(vec3 d)
+{
+    return colorTex(textureLod(skyenv, d, 0.0).rgb);
+}
+
+float reflLod(vec3 p0, vec3 p1, vec3 p2, vec2 t0, vec2 t1, vec2 t2, float texdim, float cone)
+{
+    vec2 du = t1 - t0, dv = t2 - t0;
+    float uvarea = abs(du.x * dv.y - du.y * dv.x);
+    float warea = length(cross(p1 - p0, p2 - p0));
+    float texelsPerUnit = sqrt(uvarea / max(warea, 1e-8)) * texdim;
+    return max(log2(max(cone * texelsPerUnit, 1e-6)), 0.0);
+}
+
+vec3 reflWorld(uint prim, vec2 bary, float cone)
+{
+    uint ntris = uint(max(pc.range.w, 0.0));
+    if(prim >= ntris) return vec3(0.0);
+    uvec4 t = tri.t[prim];
+    if(t.x == 0xFFFFFFFFu) return vec3(0.0);
+    int layer = int(t.x & TRI_LAYER_MASK);
+    float a = 1.0 - bary.x - bary.y, b = bary.x, c = bary.y;
+    uint i0 = idx.i[prim * 3u + 0u];
+    uint i1 = idx.i[prim * 3u + 1u];
+    uint i2 = idx.i[prim * 3u + 2u];
+    vec3 p0 = verts.v[i0].pos, p1 = verts.v[i1].pos, p2 = verts.v[i2].pos;
+    vec2 t0 = verts.v[i0].tc, t1 = verts.v[i1].tc, t2 = verts.v[i2].tc;
+    vec2 tc = t0 * a + t1 * b + t2 * c;
+    vec2 lm = verts.v[i0].lm * a + verts.v[i1].lm * b + verts.v[i2].lm * c;
+    int ndiff = int(pc.range.y);
+    float texdim = float(textureSize(diffuses, 0).x);
+    float lod = reflLod(p0, p1, p2, t0, t1, t2, texdim, cone);
+    vec3 albedo = vec3(0.5);
+    if(ndiff > 0 && layer < ndiff)
+        albedo = colorTex(textureLod(diffuses, vec3(tc, float(layer)), lod).rgb);
+    uint lmid = t.y & 0xFFFFu;
+    uint bot = t.y >> 16u;
+    int nlm = textureSize(lightmaps, 0).z;
+    if(bot != 0xFFFFu && ndiff > 0 && int(bot) < ndiff)
+    {
+        vec2 bt0 = vec2(verts.v[i0].pad, verts.v[i0].pad2);
+        vec2 bt1 = vec2(verts.v[i1].pad, verts.v[i1].pad2);
+        vec2 bt2 = vec2(verts.v[i2].pad, verts.v[i2].pad2);
+        vec2 btc = bt0 * a + bt1 * b + bt2 * c;
+        vec3 botc = colorTex(textureLod(diffuses, vec3(btc, float(bot)), reflLod(p0, p1, p2, bt0, bt1, bt2, texdim, cone)).rgb);
+        float ba = 1.0;
+        if(lmid >= 6u && nlm > 0 && int(lmid) < nlm)
+            ba = texture(lightmaps, vec3(lm, float(lmid))).a;
+        albedo = mix(botc, albedo, ba);
+    }
+    // Reserved lightmaps are constants, exactly as hitshade.comp (mode 6).
+    vec3 bake = vec3(0.098);
+    if(lmid == 2u || lmid == 3u) bake = vec3(0.502);
+    else if(lmid == 4u || lmid == 5u) bake = vec3(0.0);
+    else if(lmid >= 6u && nlm > 0 && int(lmid) < nlm)
+        bake = texture(lightmaps, vec3(lm, float(lmid))).rgb;
+    vec3 scale = vec3(float(t.z & 255u), float((t.z >> 8u) & 255u), float((t.z >> 16u) & 255u)) * (2.0 / 255.0);
+    vec3 col = albedo * bake * scale;
+    uint glayer = t.w & 255u;
+    int nglow = int(lights.env.glowLayers + 0.5);
+    if(glayer != 255u && nglow > 0 && int(glayer) < nglow)
+    {
+        vec3 gcol = vec3(float((t.w >> 8u) & 255u), float((t.w >> 16u) & 255u), float((t.w >> 24u) & 255u)) * (1.0 / 255.0);
+        col += colorTex(textureLod(glows, vec3(tc, float(glayer)), lod).rgb) * colorTex(gcol);
+    }
+    return col;
+}
+
+// hitT < 0: the ray escaped and saw the sky.
+vec3 traceReflection(vec3 ro, vec3 rd, float travelled, float pixangle, out float hitT)
+{
+    hitT = -1.0;
+    float tmax = max(pc.range.x, 1.0);
+    // World and other models; never SELF, like GL's reflection pass, which
+    // does not draw the first-person player either.
+    uint mask = RAYMASK_WORLD | RAYMASK_MODEL | RAYMASK_DYN;
+    rayQueryEXT rq;
+    rayQueryInitializeEXT(rq, tlas, 0, mask, ro, 0.02, rd, tmax);
+    while(rayQueryProceedEXT(rq))
+    {
+        if(rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
+        {
+            uint ccustom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false));
+            uint cprim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
+            uint cgeom = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, false));
+            vec2 cbary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
+            if(alphaTexel(ccustom, cprim, cgeom, cbary))
+                rayQueryConfirmIntersectionEXT(rq);
+        }
+    }
+    if(rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT)
+        return reflSky(rd);
+
+    uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
+    uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
+    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
+    float t = rayQueryGetIntersectionTEXT(rq, true);
+    hitT = t;
+    float cone = pixangle * (travelled + t);
+    if(custom == 0u) return reflWorld(prim, bary, cone);
+
+    // A model. Anything the primary pass would hand back to GL (skin overflow,
+    // no attributes) has no GL raster to fall back on here: dim neutral grey
+    // rather than a hole.
+    vec3 base = pc.lighting.xyz;
+    vec3 fallback = vec3(0.35) * max(base, vec3(0.25));
+    if((pc.mode & SHADE_MODELS) == 0 || (custom & 0xFFu) >= MAXGEOMS) return fallback;
+    ModelGeom g = geoms.g[nonuniformEXT(custom & 0xFFu)];
+    uint geomid = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true));
+    uint nopaque = g.flags >> 2u;
+    uint trii = prim + (geomid != 0u ? nopaque : 0u);
+    if((g.flags & GEOM_SHADE) == 0u || (g.verts.x == 0u && g.verts.y == 0u) || (g.indices.x == 0u && g.indices.y == 0u) || trii >= g.ntris)
+        return fallback;
+    ModelVertRef mv = ModelVertRef(g.verts);
+    ModelIdxRef mi = ModelIdxRef(g.indices);
+    uint i0 = mi.i[trii * 3u + 0u];
+    uint i1 = mi.i[trii * 3u + 1u];
+    uint i2 = mi.i[trii * 3u + 2u];
+    ModelVert v0 = mv.v[i0];
+    ModelVert v1 = mv.v[i1];
+    ModelVert v2 = mv.v[i2];
+    float a = 1.0 - bary.x - bary.y, b = bary.x, c = bary.y;
+    vec2 tc = v0.tc * a + v1.tc * b + v2.tc * c;
+    mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
+    mat3 o2wn = mat3(o2w);
+    vec3 gn = cross(v1.pos - v0.pos, v2.pos - v0.pos);
+    vec3 ng = normalize(o2wn * (length(gn) > 1e-8 ? gn : vec3(0.0, 0.0, 1.0)));
+    vec3 ln = v0.n * a + v1.n * b + v2.n * c;
+    vec3 n = length(ln) > 1e-6 ? normalize(o2wn * ln) : ng;
+    if(dot(n, -rd) < 0.0) n = -n;
+    if(dot(ng, -rd) < 0.0) ng = -ng;
+    uint nskin = geoms.g[0].ntris;
+    if((g.tris.x == 0u && g.tris.y == 0u) || nskin == 0u) return fallback;
+    ModelTriRef mt = ModelTriRef(g.tris);
+    uint packed = mt.t[trii];
+    uint layer = packed & 255u;
+    if(layer == 255u || layer >= nskin) return fallback;
+    float skindim = float(textureSize(skins, 0).x);
+    float lod = reflLod(v0.pos, v1.pos, v2.pos, v0.tc, v1.tc, v2.tc, skindim, cone);
+    vec3 albedo = colorTex(textureLod(skins, vec3(tc, float(layer)), lod).rgb) * 2.0;
+    bool fullbright = (g.flags & GEOM_FULLBRIGHT) != 0u;
+    vec3 hit = ro + rd * t;
+    vec3 lit = base * MODEL_AMBWRAP;
+    if(lights.env.skyOn > 0.5) lit += lights.env.skyColor * MODEL_AMBWRAP * 0.5;
+    if(lights.env.sunOn > 0.5)
+    {
+        vec3 sdir = lights.env.sunDir;
+        if(length(sdir) > 1e-6)
+        {
+            sdir = normalize(sdir);
+            float ndl = modelWrap(dot(n, sdir));
+            uint inst = uint(rayQueryGetIntersectionInstanceIdEXT(rq, true));
+            if(ndl > 0.0 && !occluded(hit + ng * MODEL_SHADOW_BIAS, sdir, tmax, RAYMASK_WORLD | RAYMASK_MODEL | RAYMASK_DYN, inst))
+                lit += lights.env.sunColor * ndl;
+        }
+    }
+    int nlights = clamp(int(pc.lighting.w), 0, 256);
+    int nunlim = 0;
+    for(int i = 0; i < nlights && nunlim < 16; i++)
+    {
+        if(lights.l[i].radius > 0.0) continue;
+        nunlim++;
+        vec3 L = lights.l[i].pos - hit;
+        float mag = length(L);
+        lit += lights.l[i].color * modelWrap(mag > 1e-4 ? dot(n, L / mag) : 1.0);
+    }
+    if(fullbright) lit = max(lit, vec3(max(lights.env.modelMin, MODEL_MINSHADE)));
+    if((pc.mode & HDR) == 0) lit = min(lit, vec3(1.5));
+    vec3 col = albedo * lit;
+    uint maskl = (packed >> 8u) & 255u;
+    if(maskl != 255u && maskl < nskin)
+    {
+        vec3 m = textureLod(skins, vec3(tc, float(maskl)), lod).rgb;
+        float glowk = float((packed >> 16u) & 255u) * (1.0 / 32.0);
+        col = mix(col, albedo * (0.5 * glowk), m.g);
+    }
+    return col;
+}
+
+// Water: the camera ray against every packed plane (z, then the rectangles
+// of its surfaces). The nearest plane in front of the primary world hit whose
+// rectangles hold the point wins; failing that, the nearest one passing within
+// REFL_MARGIN of them (GL's waves lift the very edge). Writes every pixel. rgb is the
+// reflection in the same space as `result`; alpha packs the plane's group
+// (1-based; planes of one height share it) times 65536 plus the length of the
+// whole reflected path (camera -> water -> what it hit, 65535 for the sky),
+// which GL turns into a depth for the particles it draws into this image.
+// 0 = nothing traced: GL then draws that pixel from its own planar texture.
+#ifndef HWRT_NO_REFL
+// Animated water: bilinear, wrapping lookup of the slope tile (uv in tiles), the
+// same filtering GL's base level gets.
+vec2 waveSlopeAt(vec2 uv)
+{
+    int n = int(lights.waveParams[0].y), m = n - 1;
+    vec2 u = uv * float(n) - 0.5;
+    ivec2 i0 = ivec2(floor(u));
+    vec2 f = u - vec2(i0);
+    int x0 = i0.x & m, x1 = (i0.x + 1) & m, y0 = (i0.y & m) * n, y1 = ((i0.y + 1) & m) * n;
+    vec2 a = mix(lights.waveSlope[y0 + x0], lights.waveSlope[y0 + x1], f.x);
+    vec2 b = mix(lights.waveSlope[y1 + x0], lights.waveSlope[y1 + x1], f.x);
+    return mix(a, b, f.y);
+}
+
+// Wave normal at a point of a water plane. The tile has no mip levels here:
+// from one texel per footprint the slope fades out (gone at three, the same
+// fade as the GL water shaders), so far water does not sparkle; it also
+// fades where the water is shallow (depth along the vertical, from the
+// primary hit behind the water), so a shore does not shimmer.
+vec3 waveNormal(vec2 p, float footprint, float depth)
+{
+    vec4 P = lights.waveParams[0], Q = lights.waveParams[1], F = lights.waveParams[2];
+    vec2 s = waveSlopeAt(p * P.z);
+    vec2 q = vec2(dot(p, Q.xy), dot(p, vec2(-Q.y, Q.x))) * Q.z;
+    vec2 s2 = waveSlopeAt(q + vec2(0.37, 0.61));
+    s += Q.w * vec2(s2.x * Q.x - s2.y * Q.y, s2.x * Q.y + s2.y * Q.x);
+    float texel = 1.0 / (P.z * P.y);
+    float fade = clamp(1.5 - 0.5 * F.x * footprint / texel, 0.0, 1.0);
+    if(F.y > 0.0) fade *= clamp(depth / F.y, 0.0, 1.0);
+    return normalize(vec3(-s * (P.w * fade), 1.0));
+}
+
+void waterReflection(ivec2 p)
+{
+    if((pc.mode & REFL_WATER) == 0) return;
+    if(p.x >= pc.size.x || p.y >= pc.size.y) return;
+    int nplanes = (pc.mode >> REFL_PLANESHIFT) & 31;
+    vec3 o = pc.origin.xyz;
+    vec3 d = worldRayDir(p);
+    const float REFL_MARGIN = 2.0;
+    float bestT = gPrimaryT, nearT = gPrimaryT;
+    int best = -1, nearest = -1;
+    if(d.z < -1e-5)
+    {
+        for(int k = 0; k < nplanes; k++)
+        {
+            Light W = lights.water[k];
+            float z = W.pos.z;
+            if(o.z <= z + 0.05) continue;
+            float t = (z - o.z) / d.z;
+            if(t <= 0.0 || t >= max(bestT, nearT)) continue;
+            vec3 hp = o + d * t;
+            if(hp.x < W.pos.x || hp.y < W.pos.y || hp.x > W.radius || hp.y > W.color.x) continue;
+            int r0 = int(W.color.z), r1 = min(r0 + int(W.flags), REFL_MAXRECTS);
+            bool inside = false, close = false;
+            for(int r = r0; r < r1; r++)
+            {
+                vec4 R = lights.waterRect[r];
+                if(hp.x >= R.x && hp.y >= R.y && hp.x <= R.z && hp.y <= R.w) { inside = true; break; }
+                if(hp.x >= R.x - REFL_MARGIN && hp.y >= R.y - REFL_MARGIN && hp.x <= R.z + REFL_MARGIN && hp.y <= R.w + REFL_MARGIN) close = true;
+            }
+            if(inside && t < bestT) { bestT = t; best = k; }
+            else if(close && t < nearT) { nearT = t; nearest = k; }
+        }
+        if(best < 0) { best = nearest; bestT = nearT; }
+    }
+    vec4 outv = vec4(0.0);
+    if(best >= 0)
+    {
+        vec3 hp = o + d * bestT;
+        vec3 rd = vec3(d.x, d.y, -d.z);
+        if(lights.waveParams[0].x > 0.5)
+        {
+            // Footprint of the pixel on the plane, between its narrow and
+            // its long (grazing) axis.
+            float footprint = reflPixelAngle() * bestT / sqrt(max(-d.z, 0.01));
+            float depth = gPrimaryT < 1e29 ? (gPrimaryT - bestT) * -d.z : 1e6;
+            rd = reflect(d, waveNormal(hp.xy, footprint, depth));
+            // a facet tilted past the view ray would send it under the water
+            if(rd.z < 0.02) rd = normalize(vec3(rd.xy, 0.02));
+        }
+        float rt;
+        vec3 c = traceReflection(hp + vec3(0.0, 0.0, 0.02), rd, bestT, reflPixelAngle(), rt);
+        float path = rt < 0.0 ? 65535.0 : min(bestT + rt, 65535.0);
+        outv = vec4(c, lights.water[best].color.y * 65536.0 + path);
+    }
+    imageStore(reflout, p, outv);
+}
+#endif
+
+// UV change one pixel right and one pixel up on the face's plane.
+vec4 worldUvGrad(ivec2 pix, vec3 p0, vec3 p1, vec3 p2, vec3 n, vec2 t0, vec2 t1, vec2 t2, vec2 tc)
+{
+    vec2 uvx = uvOnPlane(pix + ivec2(1, 0), p0, p1, p2, n, t0, t1, t2, tc);
+    vec2 uvy = uvOnPlane(pix + ivec2(0, 1), p0, p1, p2, n, t0, t1, t2, tc);
+    return vec4(wrapDelta(uvx - tc), wrapDelta(uvy - tc));
+}
+
+// Tangent-space normal map of a world face in the frame GL builds for it
+// (tangent along the texture's s axis, bitangent along t), and in .w the spec
+// map that layer carries (the diffuse alpha, resampled smoothly), -1 when the
+// face has no layer. Gradients from the pixel footprint, so a far floor does
+// not glitter.
+vec4 worldNormalSpec(uint nlayer, vec2 tc, vec4 grad, vec3 p0, vec3 p1, vec3 p2, vec3 n, vec2 t0, vec2 t1, vec2 t2)
+{
+    int nnorm = textureSize(normals, 0).z;
+    if(nlayer == TRI_NORMAL_NONE || int(nlayer) >= nnorm) return vec4(n, -1.0);
+    vec4 ns = textureGrad(normals, vec3(tc, float(nlayer)), grad.xy, grad.zw);
+    vec3 e1 = p1 - p0, e2 = p2 - p0;
+    vec2 d1 = t1 - t0, d2 = t2 - t0;
+    float det = d1.x * d2.y - d2.x * d1.y;
+    if(abs(det) < 1e-12) return vec4(n, ns.a);
+    vec3 T = (e1 * d2.y - e2 * d1.y) / det;
+    vec3 B = (e2 * d1.x - e1 * d2.x) / det;
+    T -= n * dot(n, T);
+    float tl = length(T);
+    if(tl < 1e-8) return vec4(n, ns.a);
+    T /= tl;
+    vec3 Bo = cross(n, T);
+    if(dot(Bo, B) < 0.0) Bo = -Bo;
+    vec3 nm = ns.rgb * 2.0 - 1.0;
+    vec3 nb = T * nm.x + Bo * nm.y + n * nm.z;
+    float bl = length(nb);
+    return vec4(bl > 1e-6 ? nb / bl : n, ns.a);
+}
+
+// SOFT_SIGMA: what NRD SIGMA_SHADOW_TRANSLUCENCY gets for a world pixel (else zeros): the lamps' light before their
+// shadows and the sun's N.L; the penumbra radius of the brighter source (65504 when its rays were not stopped, 0 when
+// no soft source lights the pixel); the noisy lit fractions, x the sun, yzw the lamps per colour (a source missing
+// here takes the other's).
+void storeSigma(ivec2 p, bool world)
+{
+    const vec3 lumw = vec3(0.2126, 0.7152, 0.0722);
+    vec4 u = vec4(0.0), f = vec4(0.0);
+    float pen = 0.0;
+    float lu = dot(gLampU, lumw);
+    bool sun = world && gSunV >= 0.0 && dot(gSunU, lumw) > 1e-5;
+    bool lamp = world && lu > 1e-5;
+    if(sun || lamp)
+    {
+        float sv = clamp(gSunV, 0.0, 1.0);
+        float ll = clamp(dot(gLampV, lumw) / max(lu, 1e-5), 0.0, 1.0);
+        vec3 lv = vec3(ll);
+        for(int c = 0; c < 3; c++)
+            if(gLampU[c] > 1e-5) lv[c] = clamp(gLampV[c] / gLampU[c], 0.0, 1.0);
+        f = vec4(sun ? sv : ll, lamp ? lv : vec3(sv));
+        u = vec4(lamp ? gLampU : vec3(0.0), sun ? gSunNdl : 0.0);
+        pen = (sun && (!lamp || dot(gSunU, lumw) >= gSigLampL)) ? gSigSunPen : gSigLampPen;
+    }
+    imageStore(sigu, p, u);
+    imageStore(sigpen, p, vec4(pen));
+    imageStore(sigfrac, p, f);
+}
+
+void shadePixel()
+{
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    bool live = p.x < pc.size.x && p.y < pc.size.y;
+    bool filtered = (lights.env.skyRays - floor(lights.env.skyRays)) > 0.1;
+
+    // Hoisted so every invocation reaches the workgroup barrier, including
+    // misses and the extra threads on a 16x16 tile that hang off the image.
+    vec3 n = vec3(0.0, 0.0, 1.0);
+    vec3 albedo = vec3(0.0);
+    float difflod = 0.0;
+    vec3 emit = vec3(0.0);
+    float modelglow = 3.0;
+    bool ismodel = false;
+    bool fullbright = false;
+    vec2 modelenv = vec2(0.0);
+    vec3 base = vec3(0.0);
+    float gain = 1.0;
+    vec3 direct = vec3(0.0);
+    vec3 dynAcc = vec3(0.0);
+    vec3 specAcc = vec3(0.0);
+    vec3 maskrgb = vec3(0.0);
+    bool hasmask = false;
+    float specMul = 0.0;
+    vec3 dir = vec3(0.0, 1.0, 0.0);
+    float skyvis = 0.0;
+    // 0 miss, 1 geom reject, 2 noise/occluder reset, 3 mix, 4 hold.
+    int skyReuse = 0;
+    float skyAgeShown = 0.0;
+    // Effective taps the 5x5 actually gave this pixel, (sum w)^2 / sum w^2.
+    // The kernel is narrow, so an interior pixel on open ground gets about 12
+    // of its 25 neighbours and one at a crease gets far fewer. The temporal
+    // pass needs the real count to know how noisy its own input is.
+    float skytaps = 1.0;
+    float hitdist = 0.0;
+    float skyHitDist = 0.0;
+    vec3 hitp = vec3(0.0);
+    bool valid = false;
+    vec4 outc = vec4(0.0);
+    bool nrdOn = (int(lights.env.diffPad1 + 0.5) & 32) != 0;
+    // Stage 2: hoisted out of the first block, which now stops where the lamps
+    // start so the whole tile can cull them together (tileCull has barriers).
+    bool reach = false;
+    vec3 hit = vec3(0.0);
+    vec3 sorigin = vec3(0.0);
+    float tmax = 0.0;
+    uint omnimask = 0u, nearmask = 0u, sunmask = 0u, skymask = 0u, glowbody = 0u;
+    uint skipInst = 0xFFFFFFFFu;
+    int nuse = 1;
+    // Reflections: read again after tileCull (world spec, envmap mirror).
+    uint envbits = 0u;
+    vec3 bumpn = n;
+    float specmask = 1.0;
+    float wspecScale = 0.0;
+    float reflHitT = 0.0;
+#ifdef HWRT_SKY_HALF
+    // RT quality Medium / Low: the sky rays of one row pair in two, alternating every
+    // frame; the 5x5 sky filter fills the other rows from the rows above and below.
+    // Row pairs, not a checkerboard: a 16x16 tile runs two rows per 32-wide subgroup,
+    // so whole subgroups skip the rays (a checkerboard left every subgroup waiting on
+    // its traced half and saved almost nothing).
+    // False for a pixel that left its sky rays to its neighbours.
+    bool skyTraced = true;
+#endif
+
+    if(live) do
+    {
+    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
+    vec2 ndc = uv * 2.0 - 1.0;
+
+    vec4 farh = pc.invcamproj * vec4(ndc, 1.0, 1.0);
+    vec3 farw = farh.xyz / farh.w;
+    vec3 origin = pc.origin.xyz;
+    dir = farw - origin;
+    float len = length(dir);
+    if(len < 1e-8) break;
+    dir /= len;
+
+    float tmin = max(pc.origin.w, 0.01);
+    tmax = max(pc.range.x, tmin + 1.0);
+
+    // SHADE_MODELS: primary rays hit world + other models, never SELF (the
+    // first-person body). SELF stays in the TLAS so shadow / sun / sky rays
+    // from the world still see it. MASK_MODELS without shading: world only.
+    // Both bits: shade models, and tag those hits at alpha 0.5 so the
+    // composite can keep them while still dropping world hits behind an
+    // untraced GL model (grass). No OpaqueEXT: MESH_ALPHA is a candidate,
+    // skins.a decides. Opaque BLAS triangles still commit in hardware.
+    uint primarymask = RAYMASK_ALL & ~RAYMASK_SMOKE;
+    if((pc.mode & SHADE_MODELS) != 0)
+        primarymask = RAYMASK_WORLD | RAYMASK_MODEL | RAYMASK_DYN;
+    else if((pc.mode & MASK_MODELS) != 0)
+        primarymask = RAYMASK_WORLD;
+
+    rayQueryEXT q;
+    rayQueryInitializeEXT(q, tlas, 0, primarymask, origin, tmin, dir, tmax);
+    while(rayQueryProceedEXT(q))
+    {
+        if(rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
+        {
+            uint ccustom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false));
+            uint cprim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
+            uint cgeom = uint(rayQueryGetIntersectionGeometryIndexEXT(q, false));
+            vec2 cbary = rayQueryGetIntersectionBarycentricsEXT(q, false);
+            if(alphaTexel(ccustom, cprim, cgeom, cbary))
+                rayQueryConfirmIntersectionEXT(q);
+        }
+    }
+
+    if(rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT)
+        break;
+
+    uint custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true));
+    uint prim = rayQueryGetIntersectionPrimitiveIndexEXT(q, true);
+    uint hitInst = uint(rayQueryGetIntersectionInstanceIdEXT(q, true));
+    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(q, true);
+    float a = 1.0 - bary.x - bary.y;
+    float b = bary.x;
+    float c = bary.y;
+    float hitT = rayQueryGetIntersectionTEXT(q, true);
+    hit = origin + dir * hitT;
+    hitp = hit;
+    hitdist = hitT;
+    // Window depth is the edge-stop the brief asked for: a player standing
+    // on the floor is nearer in gdepth than the ground around his feet.
+    vec3 glposP = vec3(0.0);
+    float gldistP = -1.0;
+    bool haveGlP = false;
+    if((pc.mode & TEST_GLDEPTH) != 0)
+    {
+        haveGlP = glWorldPos(p, glposP, gldistP);
+        if(haveGlP)
+        {
+            hitp = glposP;
+            hitdist = gldistP;
+        }
+    }
+
+    // Before any attribute or lighting work: if GL rasterised something in
+    // front of this hit, the hit is not what the player is looking at.
+    // Model hits skip this: the skinned BLAS sits a hair behind GL's raster
+    // (CPU skin vs GPU pose), so the test was handing every player pixel back
+    // to GL's MDL_FULLBRIGHT plate and the menu's spec never showed.
+    if((pc.mode & TEST_GLDEPTH) != 0 && custom == 0u && hiddenbygl(p, hitT))
+    {
+        // Pixel-centre direction punched through the GL-visible face at a
+        // silhouette. Camera origin is unchanged. Alpha 0 then lets the
+        // composite keep GL lighting, a bright crack against RT neighbours.
+        // Retry four subpixel directions; keep the world hit closest to this
+        // pixel's GL depth, inside the existing slack. A nearer neighbour is
+        // not accepted. Bit 12 (hwrthiddenretry) actually disables this.
+        bool recovered = false;
+        if((skyPackFlags() & 4096) != 0 && haveGlP)
+        {
+            const vec2 offs[4] = vec2[](vec2(0.4, 0.0), vec2(-0.4, 0.0), vec2(0.0, 0.4), vec2(0.0, -0.4));
+            float bestErr = 1e30;
+            uint bestCustom = 0u;
+            uint bestPrim = 0u;
+            uint bestInst = 0u;
+            vec2 bestBary = vec2(0.0);
+            float bestT = 0.0;
+            vec3 bestDir = dir;
+            for(int oi = 0; oi < 4; oi++)
+            {
+                vec2 uv2 = (vec2(p) + 0.5 + offs[oi]) / vec2(pc.size);
+                vec2 ndc2 = uv2 * 2.0 - 1.0;
+                vec4 farh2 = pc.invcamproj * vec4(ndc2, 1.0, 1.0);
+                vec3 farw2 = farh2.xyz / max(farh2.w, 1e-8);
+                vec3 dir2 = farw2 - origin;
+                float len2 = length(dir2);
+                if(len2 < 1e-8) continue;
+                dir2 /= len2;
+                rayQueryEXT q2;
+                rayQueryInitializeEXT(q2, tlas, 0, primarymask, origin, tmin, dir2, tmax);
+                while(rayQueryProceedEXT(q2))
+                {
+                    if(rayQueryGetIntersectionTypeEXT(q2, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
+                    {
+                        uint ccustom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q2, false));
+                        uint cprim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q2, false));
+                        uint cgeom = uint(rayQueryGetIntersectionGeometryIndexEXT(q2, false));
+                        vec2 cbary = rayQueryGetIntersectionBarycentricsEXT(q2, false);
+                        if(alphaTexel(ccustom, cprim, cgeom, cbary))
+                            rayQueryConfirmIntersectionEXT(q2);
+                    }
+                }
+                if(rayQueryGetIntersectionTypeEXT(q2, true) != gl_RayQueryCommittedIntersectionTriangleEXT)
+                    continue;
+                uint custom2 = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q2, true));
+                float hitT2 = rayQueryGetIntersectionTEXT(q2, true);
+                if(custom2 != 0u || !glSurfaceMatch(hitT2, gldistP)) continue;
+                float err = abs(hitT2 - gldistP);
+                if(err >= bestErr) continue;
+                bestErr = err;
+                bestCustom = custom2;
+                bestPrim = rayQueryGetIntersectionPrimitiveIndexEXT(q2, true);
+                bestInst = uint(rayQueryGetIntersectionInstanceIdEXT(q2, true));
+                bestBary = rayQueryGetIntersectionBarycentricsEXT(q2, true);
