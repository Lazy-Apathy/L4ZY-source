+static bool flamecomposeready()
+{
+    static const char *vs =
+        "attribute vec4 vvertex;\n"
+        "uniform vec4 screentexcoord0;\n"
+        "varying vec2 texcoord0;\n"
+        "void main(void) {\n"
+        "    gl_Position = vvertex;\n"
+        "    texcoord0 = vvertex.xy * screentexcoord0.xy + screentexcoord0.zw;\n"
+        "}\n";
+    static const char *ps =
+        "uniform sampler2D tex0;\n"
+        "uniform vec4 hdrflamme;\n"
+        "varying vec2 texcoord0;\n"
+        "void main(void) {\n"
+        "    vec3 a = max(texture2D(tex0, texcoord0).rgb, vec3(0.0));\n"
+        "    vec3 c = min(a, vec3(1.0));\n"
+        "    vec3 d = mix(c * (1.0 / 12.92), pow((c + 0.055) * (1.0 / 1.055), vec3(2.4)), step(vec3(0.04045), c));\n"
+        "    float s = max(a.r, max(a.g, a.b));\n"
+        "    float g = s > 1.0 ? pow(s, hdrflamme.x) : 1.0;\n"
+        "    gl_FragColor = vec4(d * g, 0.0);\n"
+        "}\n";
+    if(!flamecompose || !flamecompose->loaded() || !flamecompose->program)
+        flamecompose = newshader(0, "hdrflamecompose", vs, ps, NULL, 0);
