+    vec cam = best;
+    cam.z += 18;
+    velholdset(cam, 210.0f, -72.0f);
+    conoutf("hwrt velocity: aimsnow floor %s at %.1f %.1f %.1f from %.1f %.1f %.1f yaw 210 pitch -72 (%d floors)",
+        bestname, best.x, best.y, best.z, cam.x, cam.y, cam.z, nfound);
+}
