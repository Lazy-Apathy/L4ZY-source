+// Sharpening after DLAA/DLSS (hwrtdlsssharpness > 0): RCAS, the robust
+// contrast-adaptive sharpening of AMD FidelityFX FSR (open source, MIT),
+// with its noise limiter, on the DLAA/DLSS picture while it is put on the
+// screen. rcasparams: x = strength 2^-stops (FSR scale), yz = 1 / size.
+// Compiled on first use only (defershader): nothing changes while it is off.
+defershader 0 "hwrtdlaarcas" [
+shader 0 "hwrtdlaarcas" [
+    attribute vec4 vvertex;
+    uniform vec4 screentexcoord0;
+    varying vec2 texcoord0;
+    void main(void)
+    {
+        gl_Position = vvertex;
+        texcoord0 = vvertex.xy * screentexcoord0.xy + screentexcoord0.zw;
+    }
+] [
+    varying vec2 texcoord0;
+    uniform sampler2D tex0;
+    uniform vec4 rcasparams;
+    void main(void)
+    {
+        vec2 uv = vec2(texcoord0.x, 1.0 - texcoord0.y);
+        vec4 ec = texture2D(tex0, uv);
+        vec3 e = ec.rgb;
+        vec3 b = texture2D(tex0, uv - vec2(0.0, rcasparams.z)).rgb;
+        vec3 d = texture2D(tex0, uv - vec2(rcasparams.y, 0.0)).rgb;
+        vec3 f = texture2D(tex0, uv + vec2(rcasparams.y, 0.0)).rgb;
+        vec3 h = texture2D(tex0, uv + vec2(0.0, rcasparams.z)).rgb;
+        float bl = b.b * 0.5 + (b.r * 0.5 + b.g);
+        float dl = d.b * 0.5 + (d.r * 0.5 + d.g);
+        float el = e.b * 0.5 + (e.r * 0.5 + e.g);
+        float fl = f.b * 0.5 + (f.r * 0.5 + f.g);
+        float hl = h.b * 0.5 + (h.r * 0.5 + h.g);
+        float nz = 0.25 * (bl + dl + fl + hl) - el;
+        float range = max(max(max(bl, dl), max(el, fl)), hl) - min(min(min(bl, dl), min(el, fl)), hl);
+        nz = clamp(abs(nz) / max(range, 1.0 / 65536.0), 0.0, 1.0);
+        nz = 1.0 - 0.5 * nz;
+        vec3 mn4 = min(min(b, d), min(f, h));
+        vec3 mx4 = max(max(b, d), max(f, h));
+        vec3 hitmin = mn4 / max(4.0 * mx4, vec3(1.0 / 65536.0));
+        vec3 hitmax = (vec3(1.0) - mx4) / min(4.0 * mn4 - vec3(4.0), vec3(-1.0 / 65536.0));
