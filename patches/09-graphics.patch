+static float benchpctsorted(float *sorted, int n, float p)
+{
+    if(n <= 0) return 0;
+    int idx = int(p * float(n - 1) + 0.5f);
+    if(idx < 0) idx = 0;
+    if(idx >= n) idx = n - 1;
+    return sorted[idx];
+}
