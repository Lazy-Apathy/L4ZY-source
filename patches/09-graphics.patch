+        velmark(prev, int(s.rpx), int(s.rpy), r, g, b);
+        velmark(follow, s.sx, s.sy, r, g, b);
+        if(s.cause == VELR_VALID)
+        {
+            int vx = int((s.sx + 0.5f) + s.bufx + djx + (s.bufx + djx >= 0 ? 0.5f : -0.5f));
+            int vy = int((s.sy + 0.5f) + s.bufy + djy + (s.bufy + djy >= 0 ? 0.5f : -0.5f));
