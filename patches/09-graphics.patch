+    gathervanillateleports();
+    loopv(ents)
+    {
+        extentity &e = *ents[i];
+        if(e.type != ET_LIGHT) continue;
+        if(e.attr1 <= 0) continue;
+        // v1: skip spot cones entirely (do not evaluate, do not treat as omni).
+        if(e.attached && e.attached->type == ET_SPOTLIGHT) continue;
