+// A sampled 2D array copied back from GL with glGetTexImage. The world's
+// lightmaps and diffuse live in two of these; model skins in a third.
+struct hwrttexarray
+{
+    VkImage image;
+    VkDeviceMemory memory;
+    VkImageView view;
