+static uint32_t gwmodefromengine(int m)
+{
+    if(m == 2) return SAUER_NGX_MODE_QUALITY;
+    if(m == 3) return SAUER_NGX_MODE_BALANCED;
+    if(m == 4) return SAUER_NGX_MODE_PERFORMANCE;
+    return SAUER_NGX_MODE_DLAA;
+}
