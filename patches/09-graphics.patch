+            conoutf(CON_WARN, "hwrt velocity: proof prev skipped (size mismatch %dx%d vs %dx%d)", velw, velh, w, h);
+    }
+
+    float *velpix = new float[w * h * 4];
+    uchar *stpix = new uchar[w * h];
