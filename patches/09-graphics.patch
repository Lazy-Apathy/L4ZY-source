+    if(k > 3) k = 3;
+    if(d < 0) d = 0;
+    if(d > 1) d = 1;
+    if(!camera1)
+    {
+        conoutf("hwrt part test: no camera");
+        return;
+    }
+    seedMT(20260918u);
+    laborigin = labpartorigin(d);
+    labkind = k;
+    labdist = d;
+    hwrtvelsmoke = 0;
+    if(k == 1 || k == 3)
+    {
+        if(d == 0) particle_fireball(laborigin, 12, PART_EXPLOSION, 800, 0xFF8020, 6.0f);
+        else particle_fireball(laborigin, 40, PART_EXPLOSION, -1, 0xFF8020, 4.0f);
+    }
+    if(k == 2 || k == 3)
+    {
+        vec smokeo = labsmokeorigin(d, laborigin);
+        int fade = d == 0 ? 1200 : 900;
+        labsmokering(smokeo, 8, fade, d == 0 ? 6.0f : 4.5f, -12);
+    }
+    conoutf("hwrt part test: spawn kind %d dist %d exp %.2f %.2f %.2f lastmillis %d clock %d (seed 20260918, no veil)",
+            k, d, laborigin.x, laborigin.y, laborigin.z, lastmillis, hwrtpartlabclock);
+}
+COMMAND(hwrtpartlabspawn, "ii");
