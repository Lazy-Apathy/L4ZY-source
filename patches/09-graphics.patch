+        int ndiff = int(pc.range.y);
+        albedo = vec3(1.0, 0.0, 1.0);
+        int layer = int(t.x & TRI_LAYER_MASK);
+        if(ndiff > 0 && layer < ndiff)
+            albedo = colorTex(sampleWorldDiff(layer, tc, p, p0, p1, p2, n, tc0, tc1, tc2, (t.x >> 26u) & 7u, difflod));
