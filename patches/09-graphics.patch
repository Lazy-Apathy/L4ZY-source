diff --git a/tools/check-fxaa.py b/tools/check-fxaa.py
new file mode 100644
index 0000000000000000000000000000000000000000..3726284404d15a8fbc61558199d485d1aa0b1c32
--- /dev/null
+++ b/tools/check-fxaa.py
@@ -0,0 +1,80 @@
+"""Validate the fxaa postfx shader in data/glsl.cfg the way the engine builds it.
+
+shader.cpp prepends a version header plus the legacy-name defines, and the
+fsps macro in glsl.cfg wraps the body in main() with `color` already sampled.
+Reassembling both here means glslang sees the same text the driver would,
+so a typo shows up before the shader is loaded in a live game.
+"""
+
+import os, re, subprocess, sys, tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+CFG = os.path.join(ROOT, "data", "glsl.cfg")
+
+def find_glslang():
+    for sub in ("glslang-bin", "glslang"):
+        exe = os.path.join(ROOT, "tools", "_deps", sub, "bin",
+                           "glslang" + (".exe" if os.name == "nt" else ""))
+        if os.path.exists(exe):
+            return exe
+    return None
+
+def extract(name):
+    src = open(CFG, encoding="utf-8", errors="replace").read()
+    head = 'lazyshader 0 "%s" (fsvs) (fsps [' % name
+    i = src.index(head) + len(head)
+    j = src.index("\n] [", i)
+    body = src[i:j]
+    k = src.index("]", j + 4)
+    decls = src[j + 4:k]
+    return body, decls
+
+def assemble(body, decls, version):
+    parts = ["#version %d\n" % version]
+    if version >= 130:
+        parts.append("#define varying in\n")
+        if version < 150:
+            parts.append("precision highp float;\n")
+        parts.append("out vec4 cube2_FragColor;\n"
+                     "#define gl_FragColor cube2_FragColor\n")
+        parts.append("#define texture2D(sampler, coords) texture(sampler, coords)\n")
+    parts.append("uniform sampler2D tex0;\n"
+                 "varying vec2 texcoord0;\n")
+    parts.append(decls + "\n")
+    parts.append("void main(void)\n{\n"
+                 "    vec4 color = texture2D(tex0, texcoord0);\n")
+    parts.append(body)
+    parts.append("\n}\n")
+    return "".join(parts)
+
+def main():
+    glslang = find_glslang()
+    if not glslang:
+        print("glslang introuvable dans tools/_deps")
+        return 1
+
+    body, decls = extract("fxaa")
+    print("corps extrait : %d octets, declarations : %r" % (len(body), decls.strip()))
+    for ch in "[]@$":
+        if ch in body:
+            print("ATTENTION : le corps contient %r, que CubeScript interprete" % ch)
+            return 1
+    print("aucun caractere que CubeScript intercepte dans le corps")
+
+    bad = 0
+    for version in (120, 330):
+        text = assemble(body, decls, version)
+        path = os.path.join(tempfile.gettempdir(), "fxaa_%d.frag" % version)
+        open(path, "w", encoding="utf-8", newline="\n").write(text)
+        r = subprocess.run([glslang, path], capture_output=True, text=True)
+        ok = r.returncode == 0
+        print("\n--- #version %d : %s" % (version, "OK" if ok else "ECHEC"))
+        out = (r.stdout + r.stderr).strip()
+        if not ok or out.count("\n") > 1:
+            print(out)
+        if not ok:
+            bad += 1
+    return 1 if bad else 0
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/check-looktaa.py b/tools/check-looktaa.py
new file mode 100644
index 0000000000000000000000000000000000000000..eee7ed35bb34d823f248a213a306189359676e4d
--- /dev/null
+++ b/tools/check-looktaa.py
@@ -0,0 +1,82 @@
+"""Validate the looktaa shader the way the engine builds it.
+
+The git-tracked copy lives in data/hwrt.cfg as shader 0 "looktaa".
+data/glsl.cfg may redefine the same name next to lookssao.
+"""
+
+import os, subprocess, sys, tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+HWRT = os.path.join(ROOT, "data", "hwrt.cfg")
+GLSL = os.path.join(ROOT, "data", "glsl.cfg")
+
+def find_glslang():
+    for sub in ("glslang-bin", "glslang"):
+        exe = os.path.join(ROOT, "tools", "_deps", sub, "bin",
+                           "glslang" + (".exe" if os.name == "nt" else ""))
+        if os.path.exists(exe):
+            return exe
+    return None
+
+def extract_shader0(path, name):
+    src = open(path, encoding="utf-8", errors="replace").read()
+    head = 'shader 0 "%s" [' % name
+    i = src.index(head) + len(head)
+    j = src.index("\n] [", i)
+    vs = src[i:j]
+    k = src.index("\n]", j + 4)
+    fs = src[j + 4:k]
+    return vs, fs
+
+def assemble_fs(fs, version):
+    parts = ["#version %d\n" % version]
+    if version >= 130:
+        parts.append("#define varying in\n")
+        if version < 150:
+            parts.append("precision highp float;\n")
+        parts.append("out vec4 cube2_FragColor;\n"
+                     "#define gl_FragColor cube2_FragColor\n")
+        parts.append("#define texture2D(sampler, coords) texture(sampler, coords)\n")
+    parts.append(fs)
+    if "void main" not in fs:
+        raise SystemExit("fragment is missing main()")
+    return "".join(parts)
+
+def compile_one(glslang, text, tag):
+    path = os.path.join(tempfile.gettempdir(), "looktaa_%s.frag" % tag)
+    open(path, "w", encoding="utf-8", newline="\n").write(text)
+    r = subprocess.run([glslang, path], capture_output=True, text=True)
+    ok = r.returncode == 0
+    print("\n--- %s : %s" % (tag, "OK" if ok else "ECHEC"))
+    out = (r.stdout + r.stderr).strip()
+    if not ok or out.count("\n") > 1:
+        print(out)
+    return ok
+
+def main():
+    glslang = find_glslang()
+    if not glslang:
+        print("glslang introuvable dans tools/_deps")
+        return 1
+
+    vs, fs = extract_shader0(HWRT, "looktaa")
+    print("hwrt.cfg looktaa: vs %d octets, fs %d octets" % (len(vs), len(fs)))
+    for ch in "[]@$":
+        # The closing brackets of the CubeScript shader form are outside fs.
+        if ch in fs:
+            print("ATTENTION : le fragment hwrt.cfg contient %r" % ch)
+            return 1
+    print("aucun caractere que CubeScript intercepte dans le fragment")
+
+    bad = 0
+    for version in (120, 330):
+        if not compile_one(glslang, assemble_fs(fs, version), "hwrt_%d" % version):
+            bad += 1
+
+    if os.path.exists(GLSL) and 'lazyshader 0 "looktaa"' in open(GLSL, encoding="utf-8", errors="replace").read():
+        print("\nglsl.cfg redefine aussi looktaa (copie look-system), non verifie ici")
+
+    return 1 if bad else 0
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/compile-hwrt-shaders.py b/tools/compile-hwrt-shaders.py
new file mode 100644
index 0000000000000000000000000000000000000000..e993009e994b55867e1b024f765fec20eb500ccf
--- /dev/null
+++ b/tools/compile-hwrt-shaders.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Compile the hwrt GLSL shaders to SPIR-V and embed them as C headers.
+
+The generated headers are committed, so a normal build of the client needs no
+Vulkan SDK and no shader compiler. Only rerun this after editing a .comp file.
+
+Needs glslang; point HWRT_GLSLANG at the binary, or drop a release of
+https://github.com/KhronosGroup/glslang into tools/_deps/glslang/.
+"""
+
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SHADERS = os.path.join(ROOT, "src", "engine", "hwrt", "shaders")
+
+# (source file, C identifier[, preprocessor defines, header name])
+TARGETS = [
+    ("debug.comp", "hwrtdebugspv"),
+    ("silhouette.comp", "hwrtsilhouettespv"),
+    ("rtao.comp", "hwrtrtaospv"),
+    ("hitshade.comp", "hwrthitshadespv"),
+    ("hitlight.comp", "hwrthitlightspv"),
+    # RT Reflections and RT Specular both off: the same lighting pass without
+    # their code, so it costs what it did before they existed (trace.cpp).
+    ("hitlight.comp", "hwrthitlightnoreflspv", ["HWRT_NO_REFL"], "hitlight_norefl_comp.h"),
+    # RT quality Medium / Low: sky rays on one pixel in two (trace.cpp, hwrtquality).
+    ("hitlight.comp", "hwrthitlighthalfspv", ["HWRT_SKY_HALF"], "hitlight_half_comp.h"),
+    ("hitlight.comp", "hwrthitlighthalfnoreflspv", ["HWRT_NO_REFL", "HWRT_SKY_HALF"], "hitlight_half_norefl_comp.h"),
+    ("skycompose.comp", "hwrtskycomposespv"),
+]
+
+
+def find_glslang():
+    env = os.environ.get("HWRT_GLSLANG")
+    if env and os.path.exists(env):
+        return env
+    for name in ("glslang", "glslangValidator"):
+        for sub in ("glslang-bin", "glslang"):
+            exe = os.path.join(ROOT, "tools", "_deps", sub, "bin", name + (".exe" if os.name == "nt" else ""))
+            if os.path.exists(exe):
+                return exe
+        found = shutil.which(name)
+        if found:
+            return found
+    sys.exit("glslang not found; set HWRT_GLSLANG or install it under tools/_deps/glslang")
+
+
+def compile_one(glslang, source, identifier, defines=(), headername=None):
+    src = os.path.join(SHADERS, source)
+    with tempfile.TemporaryDirectory() as tmp:
+        spv = os.path.join(tmp, "out.spv")
+        subprocess.run([glslang, "-V", "--target-env", "vulkan1.2"] + ["-D" + d for d in defines] + ["-o", spv, src], check=True)
+        with open(spv, "rb") as f:
+            blob = f.read()
+
+    if len(blob) % 4:
+        sys.exit("%s: SPIR-V blob is not a multiple of 4 bytes" % source)
+    words = struct.unpack("<%dI" % (len(blob) // 4), blob)
+
+    header = os.path.join(SHADERS, headername or (os.path.splitext(source)[0] + "_" + source.split(".")[-1] + ".h"))
+    lines = [
+        "// Generated by tools/compile-hwrt-shaders.py from %s%s -- do not edit." % (source, "".join(" -D" + d for d in defines)),
+        "",
+        "static const uint32_t %s[] = {" % identifier,
+    ]
+    for i in range(0, len(words), 8):
+        lines.append("    " + " ".join("0x%08x," % w for w in words[i:i + 8]))
+    lines.append("};")
+    lines.append("")
+    with open(header, "w", newline="\n") as f:
+        f.write("\n".join(lines))
+    print("%s -> %s (%d words)" % (source, os.path.basename(header), len(words)))
+
+
+def main():
+    glslang = find_glslang()
+    print("using %s" % glslang)
+    for target in TARGETS:
+        compile_one(glslang, *target)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/generate-hwrt-bluenoise.py b/tools/generate-hwrt-bluenoise.py
new file mode 100644
index 0000000000000000000000000000000000000000..814c5afb1edb11e72e9f311551aa11715316947f
--- /dev/null
+++ b/tools/generate-hwrt-bluenoise.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Generate the blue-noise tile hitlight.comp uses for its sky rays.
+
+Writes src/engine/hwrt/shaders/bluenoise_tab.h (committed, like the SPIR-V
+headers), so a normal build needs neither Python nor numpy. Only rerun this if
+the tile itself has to change; the output is deterministic (fixed seeds), so a
+rerun rewrites the same bytes.
+
+What it is: two independent 128x128 void-and-cluster masks (Ulichney 1993,
+"The void-and-cluster method for dither array generation"), toroidal, Gaussian
+energy sigma 1.5. Each mask is a permutation of the ranks 0..16383, so every
+threshold of it is an even scatter of pixels: neighbouring pixels always land
+on both sides of an occluder's edge in the right proportion, which is what the
+5x5 skyvis filter needs. Mask A feeds u1 (low 16 bits of each word), mask B u2
+(high 16 bits); the value is (rank + 0.5) / 16384 quantised to 16 bits.
+Generated here from scratch: no third-party noise data, no licence attached.
+
+Needs numpy. Usage: python tools/generate-hwrt-bluenoise.py
+"""
+
+import os
+import numpy as np
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+OUT = os.path.join(ROOT, "src", "engine", "hwrt", "shaders", "bluenoise_tab.h")
+
+SIZE = 128
+SIGMA = 1.5
+SEEDS = (11, 23)
+
+
+def kernel(size, sigma):
+    d = np.arange(size)
+    d = np.minimum(d, size - d)
+    return np.exp(-(d[:, None] ** 2 + d[None, :] ** 2) / (2.0 * sigma * sigma))
+
+
+def void_and_cluster(size, sigma, seed, density=0.1):
+    rng = np.random.default_rng(seed)
+    k = kernel(size, sigma)
+    n = size * size
+    pattern = np.zeros((size, size), bool)
+    pattern.flat[rng.choice(n, size=int(n * density), replace=False)] = True
+
+    energy = np.zeros((size, size))
+
+    def splat(y, x, sign):
+        energy[:] += sign * np.roll(np.roll(k, y, 0), x, 1)
+
+    def rebuild(p):
+        energy[:] = 0
+        for y, x in zip(*np.nonzero(p)):
+            splat(y, x, 1)
+
+    def tightest(p):
+        return np.unravel_index(np.argmax(np.where(p, energy, -np.inf)), energy.shape)
+
+    def largest_void(p):
+        return np.unravel_index(np.argmin(np.where(~p, energy, np.inf)), energy.shape)
+
+    # Initial binary pattern: move the tightest cluster into the largest void
+    # until that no longer changes anything.
+    rebuild(pattern)
+    for _ in range(n):
+        a = tightest(pattern)
+        pattern[a] = False
+        splat(*a, -1)
+        b = largest_void(pattern)
+        pattern[b] = True
+        splat(*b, 1)
+        if b == a:
+            break
+
+    rank = np.zeros((size, size), np.int64)
+    ones = int(pattern.sum())
+    # Phase 1: ranks ones-1 .. 0 by removing the tightest clusters.
+    p = pattern.copy()
+    rebuild(p)
+    for r in range(ones - 1, -1, -1):
+        a = tightest(p)
+        p[a] = False
+        splat(*a, -1)
+        rank[a] = r
+    # Phases 2 and 3: ranks ones .. n-1 by filling the largest voids.
+    p = pattern.copy()
+    rebuild(p)
+    for r in range(ones, n):
+        b = largest_void(p)
+        p[b] = True
+        splat(*b, 1)
+        rank[b] = r
+    return rank
+
+
+def main():
+    n = SIZE * SIZE
+    a = void_and_cluster(SIZE, SIGMA, SEEDS[0])
+    b = void_and_cluster(SIZE, SIGMA, SEEDS[1])
+    qa = np.minimum(np.floor((a + 0.5) / n * 65536.0), 65535).astype(np.uint32)
+    qb = np.minimum(np.floor((b + 0.5) / n * 65536.0), 65535).astype(np.uint32)
+    words = (qa | (qb << 16)).ravel()
+    lines = [
