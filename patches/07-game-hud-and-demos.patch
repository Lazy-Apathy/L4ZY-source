+// ---------------------------------------------------------------------------
+//  Menu de traduction du chat, pour Cube 2: Sauerbraten.
+//
+//  Installation : poser ce fichier dans le dossier du jeu (a cote de
+//  sauerbraten.bat), puis ajouter cette ligne a autoexec.cfg, en le creant
+//  s'il n'existe pas :
+//
+//      exec "traduction.cfg"
+//
+//  Ce fichier n'ajoute pas une seule ligne au client : il ne fait que piloter
+//  des reglages qui existent deja dans le patch. Aucun fichier du jeu n'est
+//  modifie non plus.
+//
+//  Les libelles sont en anglais parce qu'ils s'affichent en jeu, ou tout le
+//  monde ne parle pas francais.
+// ---------------------------------------------------------------------------
+
+// Sur un client d'origine, ces reglages n'existent pas. Les lire ferait ecrire
+// "unknown alias lookup" dans la console a chaque demarrage : nodebug l'evite.
+nodebug [ TRAD_patche = $translateport ]
+
+if (= $TRAD_patche 0) [
+    echo "^f3traduction.cfg : ce client n'a pas le patch de traduction, menu ignore."
+] [
+
+// Un bouton de langue. La langue active s'affiche en vert.
+// Pour ajouter une langue : copier une ligne et changer le code et le nom.
+// Le modele les connait toutes, cette liste n'est qu'un raccourci.
+// Le 0 cache l'icone : sinon chaque bouton "action" elargit le menu.
+TRAD_lire = [
+    guistayopen [
+        guibutton (? (=s $translatelang    $arg1) (concatword "^f0" $arg2) $arg2) (concat translatelang    $arg1) 0
+    ]
+]
+TRAD_ecrire = [
+    guistayopen [
+        guibutton (? (=s $translateoutlang $arg1) (concatword "^f0" $arg2) $arg2) (concat translateoutlang $arg1) 0
+    ]
+]
+TRAD_exlang = [
+    guistayopen [
+        guibutton (? (=s $texamplelang $arg1) (concatword "^f0" $arg2) $arg2) (concat texamplesetlang $arg1) 0
+    ]
+]
+TRAD_modelrow = [
+    guilist [
+        guitext (tmodellabel $arg1) 0
+        guibar
+        guistayopen [ guibutton (tmodelbtn $arg1) (concat tmodelclick $arg1) 0 ]
+        guistrut 2
+        guistayopen [ guibutton "Delete" (concat tmodeldelete $arg1) 0 ]
+    ]
+]
+TRAD_update = [
+    tupdatesync
+    if (= $tupdateavail 3) [
+        guibutton "^f0Quit to Finish Update" [quit] 0
+        guitext (tupdatemsg) 0
+    ] [
+        if (= $tupdateavail 2) [
+            guitext (tupdatelabel) 0
+            guitext (tupdatemsg) 0
+        ] [
+            if $tupdateavail [
+                guistayopen [ guibutton (tupdatelabel) [tupdateapply] 0 ]
+                guitext (tupdatemsg) 0
+            ]
+        ]
+    ]
+]
+
+// Uniquement les ecritures que la police du jeu sait afficher (latin + cyrillique).
+// Pas d'arabe, chinois, japonais, coreen, grec, thai, etc. : le glyphe n'existe pas.
+TRAD_codes = "en fr de es it pt ru pl nl sv no da fi cs sk hu ro bg tr uk sr hr sl et ca id"
+TRAD_readme_codes = "bg ca cs da de en es et fi fr hr hu id it nl no pl pt ro ru sk sl sr sv tr uk"
+TRAD_readme_names = "Bulgarian Catalan Czech Danish German English Spanish Estonian Finnish French Croatian Hungarian Indonesian Italian Dutch Norwegian Polish Portuguese Romanian Russian Slovak Slovenian Serbian Swedish Turkish Ukrainian"
+TRAD_ligne = [
+    guitext (concatword "^f7" $arg1 " : ^f4" $arg2) 0
+]
+TRAD_colonne = [
+    loop i $arg2 [
+        TRAD_ligne (at $TRAD_readme_codes (+ $arg1 $i)) (at $TRAD_readme_names (+ $arg1 $i))
+    ]
+]
+TRAD_codeslist = [
+    guilist [
+        guilist [ TRAD_colonne 0 9 ]
+        guibar
+        guilist [ TRAD_colonne 9 9 ]
+        guibar
+        guilist [ TRAD_colonne 18 8 ]
+    ]
+]
+
+// Same look as the settings pages of menus.cfg (MENU_width, MENU_tab): one width so
+// the letters keep their size, views as green tabs at the top, a section title for
+// each group. Defined here too, so the page also works with an older menus.cfg.
+TRAD_width = [ guistrut 66 1 ]
+TRAD_tab = [
+    guistayopen [
+        guibutton (? (= (getalias $arg1) $arg2) (concatword "^f0" $arg3) $arg3) (concat $arg1 "=" $arg2) 0
+    ]
+]
+TRAD_col = 22
+tradtab = 0
+
+// One page, five views (tabs). The 0 turns the menu's own tab header off.
+newgui "traduction" [
+    guititle "Chat Translation"
+    TRAD_width
+    tmodelsync
+    // texamplesync interroge le service en direct (connexion bloquante, 2 s quand le port est ferme sous
+    // Windows, retentee toutes les 2 s) : sans service, la page figeait le jeu. On ne la lance que si la
+    // requete de fond des mises a jour (tupdatesync, non bloquante) a vu le service repondre.
+    if (tupdateservice) [ texamplesync ]
+    guilist [
+        TRAD_tab tradtab 0 "Translation"
+        guistrut 2
+        TRAD_tab tradtab 1 "Model"
+        guistrut 2
+        TRAD_tab tradtab 2 "Examples"
+        guistrut 2
+        TRAD_tab tradtab 3 "Shortcuts and codes"
+        guistrut 2
+        TRAD_tab tradtab 4 "Commands"
+    ]
+    guibar
+    if (= $tradtab 0) [
+        guitext (concatword "^f4L4ZY " $tradversion) 0
+        TRAD_update
+        guisection "Translate"
+        if (= (translateai) 0) [
+            guitext "^f3No AI loaded: chat translation is off." 0
+            guitext "^f4It starts once you install a model (Model tab) or an API key." 0
+        ]
+        guicheckbox "Translate incoming chat"  translatechat
+        guicheckbox "Translate team chat"      translateteamchat
+        guicheckbox "Preview while typing"     translatepreview
+        guicheckbox "I am a woman (feminine grammar)" translatefemme
+        guilist [
+            guilist [ guitext "Auto-translate" 0 ; guistrut $TRAD_col 1 ]
+            guistayopen [ guiradio "Off" translateauto 0 ]
+            guistrut 2
+            guistayopen [ guiradio "Base language" translateauto 1 ]
+            guistrut 2
+            guistayopen [ guiradio "Last spoken" translateauto 2 ]
+        ]
+        guisection "I read in"
+        guilist [
+            TRAD_lire "en" "English" ; guistrut 2
+            TRAD_lire "fr" "French"  ; guistrut 2
+            TRAD_lire "de" "German"  ; guistrut 2
+            TRAD_lire "es" "Spanish" ; guistrut 2
+            TRAD_lire "ru" "Russian"
+        ]
+        guilist [
+            TRAD_lire "pt" "Portuguese" ; guistrut 2
+            TRAD_lire "it" "Italian"    ; guistrut 2
+            TRAD_lire "pl" "Polish"     ; guistrut 2
+            TRAD_lire "nl" "Dutch"      ; guistrut 2
+            TRAD_lire "sv" "Swedish"
+        ]
+        guilist [ guitext "Other" 0 ; guistrut 2 ; guifield translatelang 4 ]
+        guisection "I send in"
+        guilist [
+            TRAD_ecrire "en" "English" ; guistrut 2
+            TRAD_ecrire "fr" "French"  ; guistrut 2
+            TRAD_ecrire "de" "German"  ; guistrut 2
+            TRAD_ecrire "es" "Spanish" ; guistrut 2
+            TRAD_ecrire "ru" "Russian"
+        ]
+        guilist [
+            TRAD_ecrire "pt" "Portuguese" ; guistrut 2
+            TRAD_ecrire "it" "Italian"    ; guistrut 2
+            TRAD_ecrire "pl" "Polish"     ; guistrut 2
+            TRAD_ecrire "nl" "Dutch"      ; guistrut 2
+            TRAD_ecrire "sv" "Swedish"
+        ]
+        guilist [ guitext "Other" 0 ; guistrut 2 ; guifield translateoutlang 4 ]
+        guitext "^f4The active language is green. Other codes: Shortcuts and codes." 0
+    ]
+    if (= $tradtab 1) [
+        guisection "Model"
+        guitext "^f4Local Qwen or Internet API." 0
+        guitext (tmodelstatus) 0
+        guitext (tmodelhint) 0
+        guitext "^f4Official Qwen (Apache-2.0). Install Small, Normal or Large here." 0
+        TRAD_modelrow "small"
+        TRAD_modelrow "normal"
+        TRAD_modelrow "large"
+        guitext "^f4Large needs ~12 GB VRAM. Drop a custom .gguf here:" 0
+        guistayopen [ guibutton "Open custom model folder" [openfolder models] 0 ]
+        if $tmodelcustomcount [
+            loop i $tmodelcustomcount [
+                guilist [
+                    guitext (tmodelcustomname $i) 0
+                    guibar
+                    guistayopen [ guibutton "Use" (concat tmodelcustomuse $i) 0 ]
+                    guistrut 2
+                    guistayopen [ guibutton "Delete" (concat tmodelcustomdel $i) 0 ]
+                ]
+            ]
+        ] [
+            guitext "^f4No custom file yet" 0
+        ]
+        guisection "Internet API (OpenAI-compatible)"
+        guilist [ guitext "Address" 0 ; guistrut 2 ; guifield tmodelurl -28 ]
+        guilist [ guitext "API Key" 0 ; guistrut 2 ; guifield tmodelkey -28 ]
+        guilist [ guitext "Model" 0 ; guistrut 2 ; guifield tmodelapimodel 16 ]
+        guitext "^f4Model empty = auto. Save does not show the key again." 0
+        guilist [
+            guistayopen [ guibutton "Save API" [tmodelsaveapi] 0 ]
+            guibar
+            guistayopen [ guibutton "Clear API Key" [tmodelclearapi] 0 ]
+        ]
+    ]
+    if (= $tradtab 2) [
+        guisection "Examples"
+        guitext "^f3Few-shot examples: more = more work for the AI (slower)" 0
+        guitext "^f4Exact translation: this phrase only, does not slow the AI." 0
+        guitext "^f4Keep as many as you want. = means leave untranslated. /tfix: same choice." 0
+        guitext (texamplestatus) 0
+        guilist [
+            TRAD_exlang "en" "English" ; guistrut 2
+            TRAD_exlang "fr" "French"  ; guistrut 2
+            TRAD_exlang "de" "German"  ; guistrut 2
+            TRAD_exlang "es" "Spanish" ; guistrut 2
+            TRAD_exlang "ru" "Russian"
+        ]
+        guilist [
+            TRAD_exlang "pt" "Portuguese" ; guistrut 2
+            TRAD_exlang "it" "Italian"    ; guistrut 2
+            TRAD_exlang "pl" "Polish"     ; guistrut 2
+            TRAD_exlang "nl" "Dutch"      ; guistrut 2
+            TRAD_exlang "sv" "Swedish"
+        ]
+        guilist [ guitext "Other" 0 ; guistrut 2 ; guifield texamplelang 4 [texamplerefresh] ]
+        guilist [
+            guilist [ guitext "Direction" 0 ; guistrut $TRAD_col 1 ]
+            guistayopen [ guiradio "Incoming Chat" texampledir 0 [texamplerefresh] ]
+            guistrut 2
+            guistayopen [ guiradio "What I Send" texampledir 1 [texamplerefresh] ]
+        ]
+        guilist [
+            guilist [ guitext "Save as" 0 ; guistrut $TRAD_col 1 ]
+            guistayopen [ guiradio "Exact Translation" texamplekind 0 ]
+            guistrut 2
+            guistayopen [ guiradio "Few-Shot Example" texamplekind 1 ]
+        ]
+        if $translatefemme [
+            guitext "^f4I am a woman is on: feminine examples are included" 0
+        ] [
+            guitext "^f4I am a woman is off: feminine-only examples stay hidden" 0
+        ]
+        guitext "Original Phrase" 0
+        guifield texamplesrc -36
+        guitext "How It Should Read" 0
+        guifield texampledst -36
+        guilist [
+            guistayopen [ guibutton "Save" [texamplesave] 0 ]
+            guibar
+            guistayopen [ guibutton "Forget This Original" [texampleforgetsrc] 0 ]
+            guibar
+            guistayopen [ guibutton "Reload List" [texamplerefresh] 0 ]
+        ]
+        if $texamplecount [
+            loop i $texamplecount [
+                guilist [
+                    guitext (texampleline $i) 0
+                    guibar
+                    guistayopen [ guibutton "Edit" (concat texampleload $i) 0 ]
+                    guistrut 2
+                    guistayopen [ guibutton "Forget" (concat texampleforget $i) 0 ]
+                ]
+            ]
+        ] [
+            guitext "^f4No examples in this list yet" 0
+        ]
+    ]
+    if (= $tradtab 3) [
+        guisection "Shortcuts"
+        guistayopen [ guibutton "Mute Translation (F7)" [toggletranslate] 0 ]
+        guistayopen [ guibutton "Expanded Chat (F10)" [togglechat] 0 ]
+        guistayopen [ guibutton "Retranslate Last Line (F9)" [tretry] 0 ]
+        guistayopen [ guibutton "Service Status" [translatestatus] 0 ]
+        guitext "Expanded Chat Size" 0
+        guislider fullchatsize
+        guitext "^f4Keys: Options > Keys > Chat and game." 0
+        guisection "Language codes"
+        TRAD_codeslist
+    ]
+    if (= $tradtab 4) [
+        guisection "Commands"
+        guitext "^f4/say always sends as typed" 0
+        guitext "^f4/tsay always uses I Send In" 0
+        guitext "^f4/trep replies in the last player's language" 0
+        guitext "^f4/to name hello : @name, follows Auto-Translate. Tab completes" 0
+        guitext "^f4/sayto name hello : @name, as typed" 0
+        guitext "^f4/tsayto name hello : @name, I Send In" 0
+        guitext "^f4/tsayr hello : careful translation, slower (a few s), sent only if it works" 0
+        guitext "^f4/tsayteamr hello : same, team chat" 0
+        guitext "^f4/trepto name hello : @name, that player's language" 0
+        guitext "^f4/tfix better : last chat line was wrong (exact or example, see Examples)" 0
+        guitext "^f4/tfixout better : last line you sent was wrong" 0
+        guitext "^f4/tretry or F9 : last chat, MOTD or [INFO] (not assists)" 0
+        guitext "^f4/tretry 12 : retranslate F10 line 12 (numbers on the left)" 0
+        guitext "^f7/tsayde hello" 0
+        guitext "^f4Replace de with a language code" 0
+        guitext "^f7/tsaytde hello" 0
+        guitext "^f4Same codes, team chat" 0
+        guitext "^f7/toteam /saytoteam /tsaytoteam /treptoteam" 0
+        guitext "^f4Same as /to /sayto /tsayto /trepto, team chat" 0
+        guitext "^f7/trepteam same as /trep, team chat" 0
+    ]
+] 0
+
+// Envoi traduit vers UNE langue, sans changer $translateoutlang (le defaut de /tsay).
+// tsay lit la cvar au moment de l'appel ; on la restore juste apres.
+TRAD_mots = [
+    concat $arg1 $arg2 $arg3 $arg4 $arg5 $arg6 $arg7 $arg8 $arg9 $arg10 $arg11 $arg12 $arg13 $arg14 $arg15 $arg16
+]
+TRAD_out = [
+    TRAD_oldout = $translateoutlang
+    translateoutlang $arg1
+    tsay (TRAD_mots $arg2 $arg3 $arg4 $arg5 $arg6 $arg7 $arg8 $arg9 $arg10 $arg11 $arg12 $arg13 $arg14 $arg15 $arg16)
+    translateoutlang $TRAD_oldout
+]
+TRAD_outteam = [
+    TRAD_oldout = $translateoutlang
+    translateoutlang $arg1
+    tsayteam (TRAD_mots $arg2 $arg3 $arg4 $arg5 $arg6 $arg7 $arg8 $arg9 $arg10 $arg11 $arg12 $arg13 $arg14 $arg15 $arg16)
+    translateoutlang $TRAD_oldout
+]
+
+// Un alias /tsayXX et /tsaytXX par code. /tsayto est une commande native
+// (pseudo, pas une langue). On n'ecrase pas tsayto / tsaytoteam ici.
+looplist TRAD_gone "zh ar he fa hi th ja ko el vi lt lv" [
+    alias (concatword tsay $TRAD_gone) []
+    alias (concatword tsayt $TRAD_gone) []
+]
+looplist TRAD_c $TRAD_codes [
+    alias (concatword tsay $TRAD_c) [
+        TRAD_out @TRAD_c (TRAD_mots $arg1 $arg2 $arg3 $arg4 $arg5 $arg6 $arg7 $arg8 $arg9 $arg10 $arg11 $arg12 $arg13 $arg14 $arg15 $arg16)
+    ]
+    alias (concatword tsayt $TRAD_c) [
+        TRAD_outteam @TRAD_c (TRAD_mots $arg1 $arg2 $arg3 $arg4 $arg5 $arg6 $arg7 $arg8 $arg9 $arg10 $arg11 $arg12 $arg13 $arg14 $arg15 $arg16)
+    ]
+]
+
+// Ouvre le menu depuis la console.
+traduction = [showgui "traduction"]
+
+// Coupe la trad, pas le chat. Meme interrupteur que les cases incoming + team.
+toggletranslate = [
+    if (|| $translatechat $translateteamchat) [
+        translatechat 0
+        translateteamchat 0
+        echo "^f4translation off (chat still shown)"
+    ] [
+        translatechat 1
+        translateteamchat 1
+        if (= (translateai) 0) [
+            echo "^f4translation on: it starts once an AI is loaded (Chat Translation > Model)"
+        ] [
+            echo "^f0translation on"
+        ]
+    ]
+]
+
+// F7 = mute trad. On n'ecrase pas une touche deja assignee.
+if (=s (getbind F7) "") [ bind F7 toggletranslate ]
+if (=s (getbind F10) "") [ bind F10 togglechat ]
+if (=s (getbind F9) "") [ bind F9 tretry ]
+if (=s (getbind F8) "") [ bind F8 togglekilllog ]
+
+] // fin du bloc "le client a bien le patch"
