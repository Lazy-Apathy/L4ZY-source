+    try:
+        st = path.stat()
+    except OSError:
+        return False
+    if st.st_size != entry["bytes"]:
+        return False
+    key = str(path.resolve())
+    prev = _hash_ok.get(key)
+    if prev == (st.st_mtime_ns, st.st_size):
+        return True
+    if _sha256_file(path) != entry["sha256"]:
+        return False
+    _hash_ok[key] = (st.st_mtime_ns, st.st_size)
+    return True
