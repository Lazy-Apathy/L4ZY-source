+static bool hdcopyfile(const char *src, const char *dst)
+{
+    stream *in = openrawfile(src, "rb");
+    if(!in) return false;
+    stream *out = openrawfile(dst, "wb");
+    if(!out) { delete in; return false; }
+    uchar buf[8192];
+    size_t n;
+    while((n = in->read(buf, sizeof(buf))) > 0) out->write(buf, n);
+    delete in;
+    delete out;
+    return true;
+}
