+    glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, vp[0], vp[1], w, h);
+    endmsaadepthread(msaaread);
+    glBindTexture(GL_TEXTURE_2D, oldtex);
+    xraysnapped = true;
