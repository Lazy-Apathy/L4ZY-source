diff --git a/data/glsl.cfg b/data/glsl.cfg
index 49b99940e7fa489530f084eae7b08b5ed1bfc117..9535c0bb5a2c15a9f8bf5cedf7159e02a105316d 100644
--- a/data/glsl.cfg
+++ b/data/glsl.cfg
@@ -2883,3 +2883,68 @@ lazyshader 0 "hdrstamp" (fsvs) (fsps [
     if(v < 0.0) discard;
     gl_FragColor = vec4(v, v, v, 1.0);
 ] [uniform vec4 hdrstamp;])
+
+
+// Demo X-ray (rendergl.cpp, demoxraydraw). Compiled the first time the X-ray
+// is switched on in a demo. Players into the mask: alpha 1 where the scene
+// depth (tex7) is in front of them, 0.5 where they are seen.
+demoxraymodelvertexshader = [
+    result [
+        @(if (>= $numargs 2) [result $arg1])
+        attribute vec4 vvertex;
+        uniform mat4 modelmatrix;
+        void main(void)
+        {
+            @(if (>= $numargs 2) [result $arg2] [result [
+                #define mpos vvertex
+            ]])
+            gl_Position = modelmatrix * mpos;
+        }
+    ]
+]
+
+defershader 0 "demoxraymodel" [
+    shader 0 "demoxraymodel" (demoxraymodelvertexshader) [
+        uniform sampler2D tex7;
+        uniform vec4 demoxraydepth, demoxraycolor;
+        float demoxraylin(float d)
+        {
+            return 2.0*demoxraydepth.z*demoxraydepth.w / (demoxraydepth.w + demoxraydepth.z - (2.0*d - 1.0)*(demoxraydepth.w - demoxraydepth.z));
+        }
+        void main(void)
+        {
+            float wall = demoxraylin(texture2D(tex7, gl_FragCoord.xy*demoxraydepth.xy).r);
+            float here = demoxraylin(gl_FragCoord.z);
+            gl_FragColor = vec4(demoxraycolor.rgb, here > wall*1.02 + 2.0 ? 1.0 : 0.5);
+        }
+    ]
+    loop i 4 [
+        variantshader 0 "demoxraymodel" 0 (demoxraymodelvertexshader (skelanimdefs (+ $i 1)) (skelanim (+ $i 1))) []
+    ]
+]
+
+// Mask -> outline around the hidden parts (1 to 3 pixels with the window
+// height), plus a light fill of them (demoxrayedge.z, 0 = outline only).
+lazyshader 0 "demoxrayedge" (fsvs) [
+    uniform sampler2D tex0;
+    uniform vec4 demoxrayedge;
+    varying vec2 texcoord0;
+    void main(void)
+    {
+        vec4 c = texture2D(tex0, texcoord0);
+        if(c.a > 0.75) { gl_FragColor = vec4(c.rgb, demoxrayedge.z); return; }
+        if(c.a > 0.25) { gl_FragColor = vec4(0.0); return; }
+        vec4 o = vec4(0.0);
+        for(int r = 1; r <= 3; r++)
+        {
+            if(float(r) > demoxrayedge.w) break;
+            for(int i = 0; i < 8; i++)
+            {
+                float a = float(i)*0.7853982;
+                vec4 n = texture2D(tex0, texcoord0 + vec2(cos(a), sin(a))*float(r)*demoxrayedge.xy);
+                if(n.a > 0.75 && o.a < 0.5) o = vec4(n.rgb, 1.0);
+            }
+        }
+        gl_FragColor = o;
+    }
+]
