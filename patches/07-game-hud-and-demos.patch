+    glBindFramebuffer_(GL_FRAMEBUFFER, xrayedgefb);
+    glFramebufferTexture2D_(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, xrayedgetex, 0);
