+
+        // 3. on the screen like the HUD
+        glBindFramebuffer_(GL_FRAMEBUFFER, oldfb);
+        glViewport(oldvp[0], oldvp[1], oldvp[2], oldvp[3]);
+        glEnable(GL_BLEND);
+        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
