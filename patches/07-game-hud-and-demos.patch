+    int namecolor(fpsent *d, int fallback)
+    {
+        int vt = visteam(d);
+        if(!vt || (d && d->state==CS_SPECTATOR)) return fallback;
+        int c = vt==1 ? 0x6496FF : 0xFF4B19;
+        if(d->state==CS_DEAD) c = (c>>1)&0x7F7F7F;
+        return c;
