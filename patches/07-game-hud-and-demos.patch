+    if not line or line.startswith("#"):
+        return None
+    parts = line.split(" | ", 2)
+    if len(parts) < 3:
+        parts = [p.strip() for p in line.split("|")]
+        if len(parts) < 3:
+            return None
+        src = parts[1]
