+        if(*c == '^' && c[1] == 'f' && c[2]) { c += 2; continue; }
+        if(*c == '\t') continue;
+        dst[n++] = *c;
+    }
+    while(n > 0 && (dst[n-1] == ' ' || dst[n-1] == ':')) n--;
+    dst[n] = 0;
