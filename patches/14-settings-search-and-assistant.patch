+    if(d && !strcmp(d, "-")) d = NULL;
+    string l = "";
+    if(e && e->label[0] && strcmp(e->label, var)) settingcleanlabel(l, e->label);
+    if(l[0] && d) nformatstring(buf, sizeof(buf), "%s - %s", l, d);
+    else copystring(buf, l[0] ? l : (d ? d : ""), sizeof(buf));
+    return buf;
+}
