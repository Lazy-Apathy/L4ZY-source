+static HWND gamehwnd()
+{
+    if(!screen) return NULL;
+    SDL_SysWMinfo info;
+    SDL_VERSION(&info.version);
+    if(!SDL_GetWindowWMInfo(screen, &info) || info.subsystem != SDL_SYSWM_WINDOWS) return NULL;
