#version 450

// Phase 1 interop probe.
//
// This shader deliberately reads nothing: every pixel GL ends up sampling can
// only have come from Vulkan writing into memory the two APIs share. The three
// patterns each fail in a different, recognisable way:
//   - the border catches a shared image that was not resized with the window,
//   - the sweep bar freezes if the GL/VK semaphore chain stops handing over,
//   - the corner patch shows the image orientation and gradient continuity.

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform writeonly image2D result;

layout(push_constant) uniform Params
{
    ivec2 size;
    int mode;   // 1 = overlay on the GL frame, 2 = opaque full screen
    int frame;
} pc;

// Row 0 is the BOTTOM of the screen: the composite quad samples with the GL
// convention, so no flip happens anywhere on the way back.
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if(p.x >= pc.size.x || p.y >= pc.size.y) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
    vec4 outc = vec4(uv.x, uv.y, 0.5, 1.0);

    if(pc.mode != 2)
    {
        outc = vec4(0.0);

        ivec2 edge = min(p, pc.size - 1 - p);
        if(min(edge.x, edge.y) < 3) outc = vec4(1.0, 0.48, 0.09, 1.0);

        float sweep = fract(float(pc.frame) / 240.0);
        if(abs(uv.x - sweep) < 0.004) outc = vec4(0.2, 1.0, 0.4, 0.85);

        if(uv.x < 0.16 && uv.y < 0.16) outc = vec4(uv.x / 0.16, uv.y / 0.16, 0.0, 0.75);
    }

    imageStore(result, p, outc);
}
