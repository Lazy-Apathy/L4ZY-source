#version 460
#extension GL_EXT_ray_query : require

// Phase 2 silhouette view (hwrtdebug 4).
//
// A primary camera ray per pixel, same clip space as the GL world pass.
// Closest-hit writes barycentric colour; miss is transparent so the vanilla
// frame shows through. Row 0 of the image is the BOTTOM of the screen.

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform writeonly image2D result;
layout(binding = 1) uniform accelerationStructureEXT tlas;

layout(push_constant) uniform Params
{
    ivec2 size;
    int mode;
    int frame;
    mat4 invcamproj;
    vec4 origin; // xyz = camera1->o, w = tmin
    vec4 range;  // x = tmax
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if(p.x >= pc.size.x || p.y >= pc.size.y) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 farh = pc.invcamproj * vec4(ndc, 1.0, 1.0);
    vec3 farw = farh.xyz / farh.w;
    vec3 origin = pc.origin.xyz;
    vec3 dir = farw - origin;
    float len = length(dir);
    if(len < 1e-8)
    {
        imageStore(result, p, vec4(0.0));
        return;
    }
    dir /= len;

    float tmin = max(pc.origin.w, 0.01);
    float tmax = max(pc.range.x, tmin + 1.0);

    rayQueryEXT q;
    // WORLD|MODEL: skip the first-person body (SELF = 0x04) so the camera
    // does not colour the inside of the skull. No OpaqueEXT so MESH_ALPHA
    // foliage / flags appear as candidates and are confirmed (the overlay
    // is meant to show the triangles are in the TLAS; holes are mode 7).
    rayQueryInitializeEXT(q, tlas, 0, 0x03, origin, tmin, dir, tmax);
    while(rayQueryProceedEXT(q))
    {
        if(rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
            rayQueryConfirmIntersectionEXT(q);
    }

    if(rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(q, true);
        vec3 col = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
        imageStore(result, p, vec4(col, 1.0));
    }
    else imageStore(result, p, vec4(0.0));
}
